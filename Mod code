            // native pointer as the generated concrete CumState type; no game mutation.
            var candidates = state.GetType().Assembly.GetTypes()
                .Where(t => t.Name == "CumState" && t.FullName != null &&
                            t.FullName.Contains("CockLimbUsage"))
                .ToArray();
