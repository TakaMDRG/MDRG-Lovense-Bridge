        private static float SegmentDistance(float px, float py, float ax, float ay, float bx, float by)
        {
            float vx = bx - ax, vy = by - ay;
            float t = Mathf.Clamp01(((px - ax) * vx + (py - ay) * vy) / (vx * vx + vy * vy + 0.0001f));
            float dx = px - (ax + vx * t), dy = py - (ay + vy * t);
            return Mathf.Sqrt(dx * dx + dy * dy);
        }
        private static Sprite LovenseIconSprite(int shape)
        {
            if (lovenseIconSprites.TryGetValue(shape, out var cached) && cached != null) return cached;
            const int n = 96;
            var tex = new Texture2D(n, n, TextureFormat.RGBA32, false);
            var pixels = new Color32[n * n];
            for (int y = 0; y < n; y++)
            for (int x = 0; x < n; x++)
            {
                float px = (x + .5f) / n * 2f - 1f;
                float py = (y + .5f) / n * 2f - 1f;
                float d = 10f;
                if (shape == 0) // Two interlocking chain links
                {
                    // Each link: rounded capsule, angled together.
                    float u = (px + py) * .7071f, v = (py - px) * .7071f;
                    float a = Mathf.Abs(u + .31f), c = Mathf.Abs(u - .31f);
                    float r1 = Mathf.Sqrt(Mathf.Pow(Mathf.Max(a - .20f, 0f), 2f) + v * v);
                    float r2 = Mathf.Sqrt(Mathf.Pow(Mathf.Max(c - .20f, 0f), 2f) + v * v);
                    d = Mathf.Min(Mathf.Abs(r1 - .24f), Mathf.Abs(r2 - .24f));
                }
                else if (shape == 2) // ECG waveform
                {
                    float[] xs = {-.87f,-.55f,-.40f,-.24f,-.08f,.10f,.24f,.42f,.56f,.88f};
                    float[] ys = {0f,0f,.26f,-.27f,.77f,-.73f,.29f,0f,0f,0f};
                    for (int i = 0; i < xs.Length - 1; i++) d = Mathf.Min(d, SegmentDistance(px, py, xs[i], ys[i], xs[i+1], ys[i+1]));
                }
                else if (shape == 5) // Three ascending signal bars
                {
                    float[] barX = { -.60f, -.08f, .44f };
                    float[] barTop = { -.35f, .15f, .72f };
                    for (int i = 0; i < 3; i++)
                        d = Mathf.Min(d, SegmentDistance(px, py, barX[i], -.72f, barX[i], barTop[i]));
                }
                else if (shape == 3) // Outline heart, parametric curve
                {
                    // Begin at the curve itself (top cleft), not at the bottom tip.
                    float prevX = 0f, prevY = (13f - 5f - 2f - 1f) / 19f;
                    for (int i = 1; i <= 120; i++)
                    {
                        float t = i * Mathf.PI * 2f / 120f;
                        float hx = 16f * Mathf.Pow(Mathf.Sin(t), 3f) / 18f;
                        float hy = (13f * Mathf.Cos(t) - 5f * Mathf.Cos(2*t) - 2f * Mathf.Cos(3*t) - Mathf.Cos(4*t)) / 19f;
                        d = Mathf.Min(d, SegmentDistance(px, py, prevX, prevY, hx, hy));
                        prevX = hx; prevY = hy;
                    }
                }
                else if (shape == 4) // Gear: outlined rim, teeth and center
                {
                    float radius = Mathf.Sqrt(px*px + py*py);
                    float theta = Mathf.Atan2(py, px);
                    float rim = .61f + (Mathf.Cos(theta*8f) > .45f ? .12f : 0f);
                    d = Mathf.Min(Mathf.Abs(radius-rim), Mathf.Abs(radius-.24f));
                    for (int i=0;i<8;i++)
                    {
                        float t=i*Mathf.PI/4f;
                        d=Mathf.Min(d,SegmentDistance(px,py,Mathf.Cos(t)*.56f,Mathf.Sin(t)*.56f,Mathf.Cos(t)*.75f,Mathf.Sin(t)*.75f));
                    }
                }
                else // Small circular status light
                    d = Mathf.Abs(Mathf.Sqrt(px*px+py*py)-.65f);
                // Signal bars have a heavier stroke than the other outline icons.
                float stroke = shape == 5 ? .125f : .065f;
                float alpha = shape == 1 ? (Mathf.Sqrt(px*px+py*py) < .65f ? 1f : 0f) : Mathf.Clamp01((stroke-d)*40f);
                pixels[y*n+x] = new Color32(255,255,255,(byte)(255f*alpha));
            }
            tex.SetPixels32(pixels); tex.Apply();
            var sprite = Sprite.Create(tex,new Rect(0,0,n,n),new Vector2(.5f,.5f),100f);
            lovenseIconSprites[shape] = sprite;
            return sprite;
        }
