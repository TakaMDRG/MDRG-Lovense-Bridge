        private static string MotorProfileKey(string deviceName, int deviceIndex, bool linear, int featureIndex)
        {
            // Index distinguishes simultaneously attached identical devices. Names are never hardcoded.
            return Convert.ToBase64String(Encoding.UTF8.GetBytes(deviceName)) + "_" + deviceIndex +
                "_" + (linear ? "L" : "V") + featureIndex;
        }

        private List<DeviceChannelProfile> ReadMotorSnapshot()
        {
            var result = new List<DeviceChannelProfile>();
            string snapshot = sender != null && sender.IsConnected ? sender.LatestDeviceSnapshot : null;
            if (string.IsNullOrEmpty(snapshot) || !snapshot.StartsWith("DEVICE_SNAPSHOT|", StringComparison.Ordinal)) return result;
            try
            {
                using (var json = JsonDocument.Parse(snapshot.Substring("DEVICE_SNAPSHOT|".Length)))
                {
                    if (json.RootElement.ValueKind != JsonValueKind.Array) return result;
                    foreach (var device in json.RootElement.EnumerateArray())
                    {
                        int index = device.TryGetProperty("index", out var ix) && ix.TryGetInt32(out int di) ? di : -1;
                        string name = device.TryGetProperty("name", out var n) ? n.GetString() ?? "Device" : "Device";
                        if (index < 0) continue;
                        foreach (bool linear in new[] { false, true })
                        {
                            string property = linear ? "linearIndices" : "vibrationIndices";
                            if (!device.TryGetProperty(property, out var features) || features.ValueKind != JsonValueKind.Array) continue;
                            foreach (var feature in features.EnumerateArray())
                            {
                                if (!feature.TryGetInt32(out int fi) || fi < 0) continue;
                                string key = MotorProfileKey(name, index, linear, fi);
                                if (!motorProfiles.TryGetValue(key, out var profile))
                                {
                                    profile = new DeviceChannelProfile { Key = key, DeviceName = name,
                                        DeviceIndex = index, FeatureIndex = fi, IsLinear = linear };
                                    motorProfiles[key] = profile;
                                }
                                profile.DeviceName = name;
                                profile.DeviceIndex = index;
                                profile.FeatureIndex = fi;
                                profile.IsLinear = linear;
                                result.Add(profile);
                            }
                        }
                    }
                }
            }
            catch (Exception ex) { MelonLogger.Warning("[MDRG MOTOR] Snapshot parse: " + ex.Message); }
            return result;
        }

        // One selected device across the entire Lovense website. Motor settings
        // are already persisted per physical device and channel by MotorProfileKey.
        private void RefreshMotorDeviceProfiles(int id, bool force = false)
        {
            string snapshot = sender != null && sender.IsConnected ? sender.LatestDeviceSnapshot : null;
            string key = snapshot ?? "(offline)";
            if (!force && motorSnapshotCache.TryGetValue(id, out var last) && last == key &&
                motorSelectedDevice.TryGetValue(id, out var current) && current == selectedDeviceIndex) return;
            motorSnapshotCache[id] = key;
            var channels = ReadMotorSnapshot();
            motorVisibleChannels[id] = channels;
            motorVisibleDeviceIndices[id] = channels.Select(c => c.DeviceIndex).Distinct().OrderBy(i => i).ToList();
            motorSelectedDevice[id] = selectedDeviceIndex;
            RefreshMotorChannels(id);
        }

        private readonly Dictionary<int, List<int>> motorVisibleDeviceIndices = new Dictionary<int, List<int>>();

        private void RefreshMotorChannels(int id)
        {
            if (!motorChannelDropdowns.TryGetValue(id, out var dropdown) || dropdown == null) return;
            var all = motorVisibleChannels.TryGetValue(id, out var channels) ? channels : new List<DeviceChannelProfile>();
            var indices = motorVisibleDeviceIndices.TryGetValue(id, out var deviceIndices) ? deviceIndices : new List<int>();
            int deviceIndex = selectedDeviceIndex;
            var visible = all.Where(c => c.DeviceIndex == deviceIndex).OrderBy(c => c.IsLinear).ThenBy(c => c.FeatureIndex).ToList();
            motorVisibleSelectedChannels[id] = visible;
            dropdown.ClearOptions();
            if (visible.Count == 0)
                dropdown.options.Add(new Il2CppTMPro.TMP_Dropdown.OptionData("No motors or strokers"));
            else
            {
                int motorNumber = 0, strokeNumber = 0;
                foreach (var profile in visible)
                    dropdown.options.Add(new Il2CppTMPro.TMP_Dropdown.OptionData(
                        profile.IsLinear ? "Stroker " + (++strokeNumber) : "Motor " + (++motorNumber)));
            }
            dropdown.SetValueWithoutNotify(0);
            dropdown.RefreshShownValue();
            motorSelectedChannel[id] = 0;
            ShowSelectedMotorSettings(id);
        }

