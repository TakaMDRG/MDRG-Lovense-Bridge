        // Choose an existing clean TMP font without shipping or replacing font files.
        private static Il2CppTMPro.TMP_FontAsset lovenseUiFont;
        private static bool lovenseFontSearched;
        private static Il2CppTMPro.TMP_FontAsset LovenseUiFont()
        {
            if (lovenseFontSearched) return lovenseUiFont;
            lovenseFontSearched = true;
            try
            {
                var fonts = UnityEngine.Resources.FindObjectsOfTypeAll<Il2CppTMPro.TMP_FontAsset>();
                foreach (var preferred in new[] { "Poppins", "Montserrat", "Inter", "Nunito Sans", "Open Sans", "OpenSans", "Roboto", "Lato", "LiberationSans", "Arial", "Noto" })
                {
                    foreach (var font in fonts)
                    {
                        if (font != null && font.name.IndexOf(preferred, StringComparison.OrdinalIgnoreCase) >= 0)
                        {
                            lovenseUiFont = font;
                            MelonLogger.Msg("[MDRG STYLE] Using UI font " + font.name);
                            return font;
                        }
                    }
                }
                MelonLogger.Warning("[MDRG STYLE] No alternate sans-serif TMP font found; using game font without outline.");
            }
            catch (Exception ex) { MelonLogger.Warning("[MDRG STYLE] Font lookup: " + ex.Message); }
            return null;
        }

