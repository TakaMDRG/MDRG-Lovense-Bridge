        private void InspectNativeUITransform(Transform node, string path, int depth, ref int count, int limit)
        {
            if (node == null || count >= limit || depth > 9) return;
            count++;
            try
            {
                var found = node.gameObject.GetComponents<UnityEngine.Component>();
                var types = new List<string>();
                foreach (var component in found)
                {
                    if (component == null) continue;
                    string nativeName = "unknown";
                    try
                    {
                        IntPtr ptr = IL2CPP.Il2CppObjectBaseToPtr(component);
                        if (ptr != IntPtr.Zero)
                        {
                            IntPtr klass = IL2CPP.il2cpp_object_get_class(ptr);
                            nativeName = Marshal.PtrToStringAnsi(IL2CPP.il2cpp_class_get_name(klass)) ?? "unknown";
                        }
                    }
                    catch (Exception ex) { nativeName = "unavailable(" + ex.GetType().Name + ")"; }
                    types.Add(nativeName);
                    if (nativeName.IndexOf("Button", StringComparison.OrdinalIgnoreCase) >= 0 ||
                        nativeName.IndexOf("Slider", StringComparison.OrdinalIgnoreCase) >= 0 ||
                        nativeName.IndexOf("Toggle", StringComparison.OrdinalIgnoreCase) >= 0 ||
                        nativeName.IndexOf("TextMesh", StringComparison.OrdinalIgnoreCase) >= 0 ||
                        nativeName.IndexOf("TMP_", StringComparison.OrdinalIgnoreCase) >= 0)
                    {
                        MelonLogger.Msg("[MDRG NATIVEUI] CONTROL path=" + path + " | native=" + nativeName +
                            " | managed=" + component.GetType().FullName);
                    }
                }
                MelonLogger.Msg("[MDRG NATIVEUI] NODE " + path + " | types=" +
                    string.Join(", ", types) + " | children=" + node.childCount);
            }
            catch (Exception ex)
            { MelonLogger.Warning("[MDRG NATIVEUI] NODE " + path + " error: " + ex.Message); }
            for (int i = 0; i < node.childCount && count < limit; i++)
            {
                try
                {
                    Transform child = node.GetChild(i);
                    InspectNativeUITransform(child, path + "/" + child.name, depth + 1, ref count, limit);
                }
                catch (Exception ex)
                { MelonLogger.Warning("[MDRG NATIVEUI] Child error: " + ex.Message); }
            }
        }

        private void InspectRegisteredWebsites()
        {
            try
            {
                // Includes inactive objects. No instantiation or mutation.
                var instances = UnityEngine.Resources.FindObjectsOfTypeAll<InternetSingleton>();
                if (instances == null) return;

                foreach (var internet in instances)
                {
                    if (internet == null) continue;
                    int instanceId = internet.GetInstanceID();
                    if (inspectedInternetInstances.Contains(instanceId)) continue;

                    var sites = internet.websitePrefabs;
                    if (sites == null) continue; // Not initialized yet; retry.

                    InspectBrowserRouting(internet);
                    InspectRegistrationPrerequisites(internet);
                    TestTemporaryWebsiteRegistration(internet);
                    TestIsolatedWebsiteClone(internet);
                    InspectRuntimeWebsiteReferences(internet);
                    TestConstructedWebsiteReference(internet);
                    RegisterBrowserNavigationTest(internet);
                    InspectCasinoSubpageUI(internet);
                    MelonLogger.Msg("[MDRG WEBSITE] InternetSingleton=" + instanceId +
                        " | Website count=" + sites.Count);

                    for (int i = 0; i < sites.Count; i++)
                    {
                        try
                        {
                            var site = sites[i];
                            if (site == null)
                            {
                                MelonLogger.Msg("[MDRG WEBSITE] Entry " + i + " | NULL");
                                continue;
                            }

                            var reference = site.WebsiteReference;
                            var loader = reference != null ? reference.resourcesReferenceLoader : null;
                            string url = site.GameUrl != null ? site.GameUrl.ToString() : "(null)";
                            MelonLogger.Msg("[MDRG WEBSITE] Entry " + i +
                                " | URL=" + url + " | Listed=" + site.IsListed +
                                " | ReferenceNull=" + (reference == null));
                            if (site.GameUrl != null)
                                InspectWebsiteObject(site.GameUrl, "GameUrl[" + i + "]", i == 0);
                            // Inspect only the first website reference. Get() may resolve an
                            // existing asset, but we do not instantiate or activate it.
                            if (i == 0 && reference != null)
                            {
                                InspectWebsiteObject(reference, "WebsiteReference", true);
                                try
                                {
                                    MelonLogger.Msg("[MDRG WEBSITE] Prefab retrieval test: calling WebsiteReference.Get() for " + site.GameUrl.Assembled);
                                    var prefab = reference.Get();
                                    if (prefab == null)
                                        MelonLogger.Msg("[MDRG WEBSITE] Prefab retrieval returned NULL");
                                    else
                                    {
                                        MelonLogger.Msg("[MDRG WEBSITE] Prefab retrieval succeeded | name=" + prefab.name +
                                            " | instanceID=" + prefab.GetInstanceID() +
                                            " | activeSelf=" + prefab.gameObject.activeSelf +
                                            " | scene=" + prefab.gameObject.scene.name);
                                        InspectWebsiteObject(prefab, "RetrievedWebsite", true);
                                        InspectPrefabStructure(prefab);
                                    }
                                }
                                catch (Exception prefabError)
                                {
                                    MelonLogger.Warning("[MDRG WEBSITE] Prefab retrieval failed: " +
                                        prefabError.GetType().Name + ": " + prefabError.Message);
                                }
                            }

                            if (loader != null)
                            {
                                MelonLogger.Msg("[MDRG WEBSITE]   Resource path=" + loader.path +
                                    " | GUID=" + loader.assetGuid +
                                    " | LocalID=" + loader.assetLocalId +
                                    " | Empty=" + loader.isEmpty +
                                    " | InResources=" + loader.isInResourcesFolder +
                                    " | MainAsset=" + loader.isMainAsset);
                            }
                            else
                            {
                                MelonLogger.Msg("[MDRG WEBSITE]   Resource loader unavailable");
                            }
                        }
                        catch (Exception entryError)
                        {
                            MelonLogger.Warning("[MDRG WEBSITE] Entry " + i +
                                " inspection failed: " + entryError.Message);
                        }
                    }

                    inspectedInternetInstances.Add(instanceId);
                    MelonLogger.Msg("[MDRG WEBSITE] Read-only inspection complete.");
                }
            }
            catch (Exception ex)
            {
                MelonLogger.Warning("[MDRG WEBSITE] Inspection deferred: " +
                    ex.GetType().Name + ": " + ex.Message);
            }
        }

        // v3.3.19: metadata only. Does not call TryFindWebsite, Load, Open,
        // Instantiate, or mutate any browser state.
        private void InspectBrowserRouting(InternetSingleton internet)
        {
            try
            {
                MelonLogger.Msg("[MDRG ROUTE] InternetSingleton managed type=" + internet.GetType().FullName);
                var flags = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.DeclaredOnly;
                foreach (var p in internet.GetType().GetProperties(flags))
                    MelonLogger.Msg("[MDRG ROUTE] PROPERTY " + p.PropertyType.FullName + " " + p.Name);
                foreach (var m in internet.GetType().GetMethods(flags))
                {
                    if (m.IsSpecialName) continue;
                    MelonLogger.Msg("[MDRG ROUTE] METHOD " + m.ReturnType.FullName + " " + m.Name +
                        "(" + string.Join(", ", m.GetParameters().Select(x =>
                        x.ParameterType.FullName + " " + x.Name + (x.IsOut ? " [out]" : ""))) + ")");
                }
                // BrowserPopup is a separate class; inspect its declared method
                // signatures without creating an instance or invoking them.
                var browserType = typeof(BrowserPopup);
                MelonLogger.Msg("[MDRG ROUTE] BrowserPopup type=" + browserType.FullName);
                foreach (var m in browserType.GetMethods(flags))
                {
                    if (m.IsSpecialName) continue;
                    MelonLogger.Msg("[MDRG ROUTE] POPUP METHOD " + m.ReturnType.Name + " " + m.Name +
                        "(" + string.Join(", ", m.GetParameters().Select(x =>
                        x.ParameterType.Name + " " + x.Name)) + ")");
                }
            }
            catch (Exception ex)
            {
                MelonLogger.Warning("[MDRG ROUTE] Metadata inspection failed: " + ex.Message);
            }
        }

        // v3.3.20: Determine which constructors and setters are available before
        // attempting to create a new registry entry. This test never mutates the
        // registry, clones a prefab, or navigates the browser.
        private void InspectRegistrationPrerequisites(InternetSingleton internet)
        {
            try
            {
                const BindingFlags flags = BindingFlags.Public | BindingFlags.NonPublic |
                                           BindingFlags.Instance | BindingFlags.Static;
                Type[] types = {
                    typeof(WebsiteSerializableAsset), typeof(GameUrl),
                    typeof(GameUrlWithArguments), typeof(Website),
                    typeof(InternetSingleton)
                };
                foreach (var type in types)
                {
                    MelonLogger.Msg("[MDRG REG] TYPE " + type.FullName);
                    foreach (var ctor in type.GetConstructors(flags))
                        MelonLogger.Msg("[MDRG REG] CTOR " + type.Name + "(" +
                            string.Join(", ", ctor.GetParameters().Select(p => p.ParameterType.Name + " " + p.Name)) + ")");
                    foreach (var property in type.GetProperties(flags | BindingFlags.DeclaredOnly))
                        MelonLogger.Msg("[MDRG REG] PROPERTY " + property.PropertyType.Name + " " +
                            property.Name + " get=" + (property.GetGetMethod(true) != null) +
                            " set=" + (property.GetSetMethod(true) != null));
                    foreach (var method in type.GetMethods(flags | BindingFlags.DeclaredOnly))
                    {
                        if (method.IsSpecialName) continue;
                        string name = method.Name;
                        if (!(name.Contains("FromString") || name.Contains("Parse") ||
                              name.Contains("Load") || name.Contains("Get") ||
                              name.Contains("Find") || name.Contains("ChangeTo"))) continue;
                        MelonLogger.Msg("[MDRG REG] METHOD " + method.ReturnType.Name + " " +
                            type.Name + "." + name + "(" + string.Join(", ",
                            method.GetParameters().Select(p => p.ParameterType.Name + " " + p.Name +
                            (p.IsOut ? " [out]" : ""))) + ")");
                    }
                }
                var sites = internet.websitePrefabs;
                if (sites != null && sites.Count > 0 && sites[0] != null)
                {
                    var entry = sites[0];
                    MelonLogger.Msg("[MDRG REG] Existing entry URL=" +
                        (entry.GameUrl == null ? "(null)" : entry.GameUrl.Assembled) +
                        " | referencePresent=" + (entry.WebsiteReference != null));
                }
                MelonLogger.Msg("[MDRG REG] Inspection complete; registry unchanged.");
            }
            catch (Exception ex)
            {
                MelonLogger.Warning("[MDRG REG] Inspection failed: " +
                    ex.GetType().Name + ": " + ex.Message);
            }
        }

        // v3.3.22: Temporary lookup-only experiment. Reuse an existing asset
        // reference for resolution testing; do NOT alter its prefab or navigate.
        private void TestTemporaryWebsiteRegistration(InternetSingleton internet)
        {
            var sites = internet.websitePrefabs;
            if (sites == null || sites.Count == 0) return;
            WebsiteSerializableAsset temporary = null;
            bool inserted = false;
            try
            {
                WebsiteSerializableAsset template = null;
                for (int i = 0; i < sites.Count; i++)
                {
                    var candidate = sites[i];
                    if (candidate != null && candidate.GameUrl != null &&
                        candidate.GameUrl.Assembled == "bang.ic" &&
                        candidate.WebsiteReference != null)
                    {
                        template = candidate;
                        break;
                    }
                }
                if (template == null)
                {
                    MelonLogger.Warning("[MDRG REGTEST] Skipped: bang.ic template not available.");
                    return;
                }
                for (int i = 0; i < sites.Count; i++)
                {
                    if (sites[i] != null && sites[i].GameUrl != null &&
                        sites[i].GameUrl.Assembled == "lovense.ic")
                    {
                        MelonLogger.Warning("[MDRG REGTEST] Skipped: lovense.ic already registered.");
                        return;
                    }
                }
                temporary = new WebsiteSerializableAsset();
                temporary.GameUrl = new GameUrl("lovense.ic");
                temporary.IsListed = false;
                // Borrow only the reference object. Never modify it or its target.
                temporary.WebsiteReference = template.WebsiteReference;
                int before = sites.Count;
                sites.Add(temporary);
                inserted = true;
                MelonLogger.Msg("[MDRG REGTEST] Added temporary lovense.ic entry | before=" + before +
                    " after=" + sites.Count + " | reference=bang.ic (borrowed)");
                InternetSingleton.WebsiteSearchData result;
                bool found = internet.TryFindWebsite(new GameUrlWithArguments("lovense.ic"), out result);
                MelonLogger.Msg("[MDRG REGTEST] TryFindWebsite(lovense.ic) returned=" + found +
                    " | dataNull=" + (result == null));
                if (result != null)
                {
                    MelonLogger.Msg("[MDRG REGTEST] Resolved prefab=" +
                        (result.Website == null ? "(null)" : result.Website.name) +
                        " | output=" + (result.OutputAddress == null ? "(null)" :
                        result.OutputAddress.AssembledWithArguments));
                }
            }
            catch (Exception ex)
            {
                MelonLogger.Warning("[MDRG REGTEST] Exception: " +
                    ex.GetType().Name + ": " + ex.Message);
            }
            finally
            {
                if (inserted && temporary != null)
                {
                    try
                    {
                        // Remove by object identity, not URL or index, so no
                        // existing website entry can be accidentally removed.
                        bool removed = sites.Remove(temporary);
                        MelonLogger.Msg("[MDRG REGTEST] Cleanup removed=" + removed +
                            " | registry count=" + sites.Count);
                    }
                    catch (Exception ex)
                    {
                        MelonLogger.Error("[MDRG REGTEST] Cleanup failed: " + ex.Message);
                    }
                }
            }
        }

