                var machine = usage.GetType().GetProperty("FrickStateMachine",
                    BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance)?.GetValue(usage);
                var state = machine?.GetType().GetProperty("CurrentState",
                    BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance)?.GetValue(machine);
                if (state == null) return;
                var native = state as Il2CppObjectBase;
                if (native == null) return;
                IntPtr ptr = IL2CPP.Il2CppObjectBaseToPtr(native);
                if (ptr == IntPtr.Zero) return;
                IntPtr klass = IL2CPP.il2cpp_object_get_class(ptr);
                string nativeName = Marshal.PtrToStringAnsi(IL2CPP.il2cpp_class_get_name(klass)) ?? "UNKNOWN";
                if (nativeName != "CumState") return;
