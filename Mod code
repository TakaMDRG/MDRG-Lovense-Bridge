        private void RefreshLovenseControls()
        {
            if (sender != null && Time.unscaledTime - lastIntifaceStatusPoll >= 2f)
            {
                lastIntifaceStatusPoll = Time.unscaledTime;
                sender.Enqueue("INTIFACE_STATUS_REQUEST");
            }
            if (sender != null && sender.IsConnected && Time.unscaledTime - lastDeviceListPoll >= 4f)
            {
                lastDeviceListPoll = Time.unscaledTime;
                sender.Enqueue("DEVICE_SNAPSHOT_REQUEST");
            }
            foreach (var pair in uiSliders.ToArray())
            {
                int id = pair.Key;
                var slider = pair.Value;
                if (slider == null || slider.gameObject == null) { uiSliders.Remove(id); continue; }
                RefreshDeviceDropdown(id);
                RefreshMotorDeviceProfiles(id);
                SendBridgeSettings();
                if (uiDeviceLabels.TryGetValue(id, out var deviceLabel) && deviceLabel != null)
                    deviceLabel.text = sender == null || !sender.IsConnected
                        ? "No devices detected"
                        : FormatDetectedDevices(sender.LatestDeviceSnapshot);
                if (uiStatuses.TryGetValue(id, out var status) && status != null)
                {
                    string state = sender == null ? null : sender.LatestIntifaceStatus;
                    bool bridgeConnected = sender != null && sender.IsConnected;
                    if (lovenseStatusIndicators.TryGetValue(id, out var statusLight) && statusLight != null)
                    {
                        bool connected = bridgeConnected && state != null &&
                            state.StartsWith("INTIFACE_STATUS|CONNECTED|", StringComparison.Ordinal);
                        bool pending = bridgeLaunchPending || (bridgeConnected &&
                            (state == null || state.StartsWith("INTIFACE_STATUS|CONNECTING|", StringComparison.Ordinal)));
                        statusLight.color = connected ? new Color(.28f,.88f,.58f,1f) :
                            pending ? new Color(1f,.73f,.25f,1f) : new Color(.95f,.29f,.36f,1f);
                    }
                    status.text = bridgeLaunchError != null ? "Connection status: " + bridgeLaunchError : bridgeLaunchPending ? "Connection status: Starting bridge..." : !bridgeConnected ? "Connection status: Bridge offline" :
                        state == null ? "Connection status: Checking Intiface..." :
                        state.StartsWith("INTIFACE_STATUS|CONNECTED|", StringComparison.Ordinal) ? "Connection status: Intiface connected" :
                        state.StartsWith("INTIFACE_STATUS|CONNECTING|", StringComparison.Ordinal) ? "Connection status: Connecting..." :
                        state.StartsWith("INTIFACE_STATUS|FAILED|", StringComparison.Ordinal) ? "Connection status: Connection failed (check bridge console)" :
                        "Connection status: Intiface disconnected";
                }
                if (uiConnectLabels.TryGetValue(id, out var connectLabel) && connectLabel != null)
                    connectLabel.text = sender != null && sender.LatestIntifaceStatus != null &&
                        sender.LatestIntifaceStatus.StartsWith("INTIFACE_STATUS|CONNECTED|", StringComparison.Ordinal)
                        ? "Disconnect Intiface" : "Connect to Intiface";
                if (uiSyncLabels.TryGetValue(id, out var sync) && sync != null)
                    sync.text = "Device synchronization: " + (syncEnabled ? "Enabled" : "Disabled") + " (settings only)";
                if (uiIntensityLabels.TryGetValue(id, out var label) && label != null)
                    label.text = "Intensity multiplier: " + (int)Math.Round(intensityMultiplier * 100f) + "% (settings only)";
                if (orgasmToggleLabels.TryGetValue(id, out var orgasmLabel) && orgasmLabel != null)
                    orgasmLabel.text = orgasmResponseEnabled ? "Enabled" : "Disabled";
                if (motorToggleLabels.TryGetValue(id, out var motorLabel) && motorLabel != null)
                    motorLabel.text = motorResponseEnabled ? "Enabled" : "Disabled";
                if (uiButtonLabels.TryGetValue(id, out var buttonLabel) && buttonLabel != null)
                    buttonLabel.text = syncEnabled ? "Sync enabled" : "Sync disabled";
            }
        }

        private void SelectLovenseDevice(int id, int option)
        {
            if (!dropdownDeviceIndices.TryGetValue(id, out var indices)) return;
            selectedDeviceIndex = option > 0 && option <= indices.Count ? indices[option - 1] : -1;
            SwitchDeviceSettings(selectedDeviceIndex);
            foreach (var panelId in motorPanelRoots.Keys.ToArray())
                RefreshMotorDeviceProfiles(panelId, true);
            MelonLogger.Msg("[MDRG DROPDOWN] Selected device index=" + selectedDeviceIndex + "; matching motor profile displayed.");
        }

        private void RefreshDeviceDropdown(int id)
        {
            if (!uiDeviceDropdowns.TryGetValue(id, out var dropdown) || dropdown == null) return;
            string snapshot = sender != null && sender.IsConnected ? sender.LatestDeviceSnapshot : null;
            string key = snapshot ?? "(offline)";
            if (dropdownSnapshots.TryGetValue(id, out var previous) && previous == key) return;
            dropdownSnapshots[id] = key;
            var names = new List<string>();
            var indices = new List<int>();
            deviceNamesByIndex.Clear();
            if (!string.IsNullOrEmpty(snapshot) && snapshot.StartsWith("DEVICE_SNAPSHOT|", StringComparison.Ordinal))
            {
                try
                {
                    using (var json = JsonDocument.Parse(snapshot.Substring("DEVICE_SNAPSHOT|".Length)))
                    {
                        if (json.RootElement.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var device in json.RootElement.EnumerateArray())
                            {
                                int index = device.TryGetProperty("index", out var ix) && ix.TryGetInt32(out int parsed) ? parsed : -1;
                                string name = device.TryGetProperty("name", out var n) ? n.GetString() ?? "Unknown device" : "Unknown device";
                                names.Add((index >= 0 ? "#" + index + " " : "") + name);
                                indices.Add(index);
                                if (index >= 0) deviceNamesByIndex[index] = name;
                            }
                        }
                    }
                }
                catch (Exception ex) { MelonLogger.Warning("[MDRG DROPDOWN] Snapshot parse: " + ex.Message); }
            }
            dropdownDeviceIndices[id] = indices;
            dropdown.ClearOptions();
            dropdown.options.Add(new Il2CppTMPro.TMP_Dropdown.OptionData(names.Count == 0 ? "No devices detected" : "Select a device"));
            foreach (string name in names) dropdown.options.Add(new Il2CppTMPro.TMP_Dropdown.OptionData(name));
            int selectedOption = selectedDeviceIndex < 0 ? 0 : indices.IndexOf(selectedDeviceIndex) + 1;
            // Automatically select the first detected device when there is no
            // valid selection (initial connection or device removal).
            if (selectedOption == 0 && indices.Count > 0)
            {
                selectedOption = 1;
                selectedDeviceIndex = indices[0];
            }
            else if (selectedOption == 0)
            {
                selectedDeviceIndex = -1;
            }
            dropdown.SetValueWithoutNotify(selectedOption);
            dropdown.RefreshShownValue();
            SwitchDeviceSettings(selectedDeviceIndex);
            foreach (var panelId in motorPanelRoots.Keys.ToArray())
                RefreshMotorDeviceProfiles(panelId, true);
            MelonLogger.Msg("[MDRG DROPDOWN] Refreshed options=" + names.Count + " selected=" + selectedDeviceIndex);
        }

        private static Il2CppTMPro.TextMeshProUGUI FindLovenseLabel(Transform parent, string prefix)
        {
            for (int i = 0; i < parent.childCount; i++)
            {
                var child = parent.GetChild(i);
                if (child == null || !child.name.StartsWith("Lovense Label - " + prefix, StringComparison.Ordinal)) continue;
                return child.GetComponent<Il2CppTMPro.TextMeshProUGUI>();
            }
            return null;
        }

        private static bool ClonePreviewLabel(GameObject source, Transform parent, string text,
            float x, float y, float width, float height, float fontSize)
        {
            var clone = UnityEngine.Object.Instantiate(source, parent, false);
            clone.name = "Lovense Label - " + text;
            DisablePreviewBehaviours(clone);
            PositionPreview(clone.transform, x, y, width, height);
            return SetPreviewText(clone, text, fontSize);
        }

        private static bool SetPreviewText(GameObject obj, string text, float fontSize)
        {
            try
            {
                var components = obj.GetComponents<UnityEngine.Component>();
                foreach (var c in components)
                {
                    if (c == null || GetNativeComponentName(c) != "TextMeshProUGUI") continue;
                    var tmp = c.TryCast<Il2CppTMPro.TextMeshProUGUI>();
                    if (tmp == null) continue;
                    tmp.text = text;
                    tmp.fontSize = fontSize;
                    StyleLovenseText(tmp);
                    // Concept uses stronger section headings and lighter supporting copy.
                    // Keep the large two-tone title regular rather than artificially bold.
                    tmp.fontStyle = fontSize >= 23f && fontSize < 42f
                        ? Il2CppTMPro.FontStyles.Bold : Il2CppTMPro.FontStyles.Normal;
                    tmp.enableAutoSizing = false;
                    return true;
                }
            }
            catch (Exception ex) { MelonLogger.Warning("[MDRG PAGE] Text update failed: " + ex.Message); }
            return false;
        }

        private static string GetNativeComponentName(UnityEngine.Component component)
        {
            try
            {
                IntPtr ptr = IL2CPP.Il2CppObjectBaseToPtr(component);
                if (ptr == IntPtr.Zero) return "";
                IntPtr klass = IL2CPP.il2cpp_object_get_class(ptr);
                return Marshal.PtrToStringAnsi(IL2CPP.il2cpp_class_get_name(klass)) ?? "";
            }
            catch { return ""; }
        }

        private static void DisablePreviewBehaviours(GameObject obj)
        {
            foreach (var component in obj.GetComponentsInChildren<UnityEngine.Component>(true))
            {
                if (component == null) continue;
                string name = GetNativeComponentName(component);
                // Preserve visual renderers, text, and images. Remove casino behaviour
                // from cloned controls, plus localization scripts that rewrite our labels.
                if (name != "Button" && name != "Slider" && name != "StakeSelector" &&
                    name != "LocalizeTextMeshProFont" && name != "GameObjectLocalizer" &&
                    name != "VerticalLayoutGroup" && name != "HorizontalLayoutGroup") continue;
                try
                {
                    var behaviour = component.TryCast<Behaviour>();
                    if (behaviour != null) behaviour.enabled = false;
                }
                catch (Exception ex) { MelonLogger.Warning("[MDRG PAGE] Disable " + name + ": " + ex.Message); }
            }
        }

        private static void PositionPreview(Transform transform, float x, float y, float width, float height)
        {
            try
            {
                var rect = transform.TryCast<RectTransform>();
                if (rect == null) return;
                rect.anchorMin = new Vector2(0.5f, 0.5f);
                rect.anchorMax = new Vector2(0.5f, 0.5f);
                rect.pivot = new Vector2(0.5f, 0.5f);
                rect.sizeDelta = new Vector2(width, height);
                rect.anchoredPosition = new Vector2(x, y);
                rect.localScale = Vector3.one;
            }
            catch (Exception ex) { MelonLogger.Warning("[MDRG PAGE] Positioning failed: " + ex.Message); }
        }

