                {
                    Type concrete = candidate;
                    if (concrete.ContainsGenericParameters)
                    {
                        Type[] args = state.GetType().GetGenericArguments();
                        if (args.Length != concrete.GetGenericArguments().Length) continue;
                        concrete = concrete.MakeGenericType(args);
                    }
                    var ctor = concrete.GetConstructor(new[] { typeof(IntPtr) });
                    if (ctor == null) continue;
                    object result = ctor.Invoke(new object[] { ptr });
                    var field = concrete.GetField("leftml", BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance);
                    var prop = concrete.GetProperty("leftml", BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance);
                    if (field != null) return field.GetValue(result);
                    if (prop != null) return prop.GetValue(result);
                }
                catch (Exception ex)
                {
                    logger?.Invoke("SEMEN_NATIVE | WrapperAttempt=" + candidate.FullName + " | Error=" + ex.GetType().Name);
                }
            }
            throw new MissingFieldException("No generated concrete CumState wrapper exposes leftml; candidates=" + candidates.Length);
        }

