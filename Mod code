        private void InspectReferenceType(string label, System.Type type)
        {
            const BindingFlags flags = BindingFlags.Public | BindingFlags.NonPublic |
                                       BindingFlags.Instance | BindingFlags.Static;
            MelonLogger.Msg("[MDRG REF] TYPE " + label + "=" + type.FullName);
            foreach (var ctor in type.GetConstructors(flags))
                MelonLogger.Msg("[MDRG REF] CTOR " + label + " " + ctor);
            foreach (var prop in type.GetProperties(flags))
            {
                if (prop.DeclaringType != type) continue;
                MelonLogger.Msg("[MDRG REF] PROPERTY " + label + " " +
                    prop.PropertyType.Name + " " + prop.Name +
                    " get=" + (prop.GetGetMethod(true) != null) +
                    " set=" + (prop.GetSetMethod(true) != null));
            }
            foreach (var method in type.GetMethods(flags))
            {
                if (method.DeclaringType != type || method.IsSpecialName) continue;
                MelonLogger.Msg("[MDRG REF] METHOD " + label + " " + method);
            }
        }

        // v3.3.24: Construct an independent loader/reference using a known
