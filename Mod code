            IntPtr ptr = IL2CPP.Il2CppObjectBaseToPtr(wrapper);
            if (ptr == IntPtr.Zero) throw new InvalidOperationException("CurrentState pointer is null");
            IntPtr klass = IL2CPP.il2cpp_object_get_class(ptr);
            string nativeName = Marshal.PtrToStringAnsi(IL2CPP.il2cpp_class_get_name(klass)) ?? "UNKNOWN";
            if (nativeName != "CumState") logger?.Invoke("SEMEN_NATIVE | Controller=" + controller + " | NativeState=" + nativeName);
            if (!nativeName.Contains("CumState"))
                throw new InvalidOperationException("Native state is " + nativeName + ", not CumState");

