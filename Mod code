        private readonly List<Il2CppTMPro.TMP_Dropdown> orgasmModeDropdowns = new List<Il2CppTMPro.TMP_Dropdown>();
        private string activeDeviceSettingsKey;
        private string DeviceSettingsKey(int index)
        {
            return index >= 0 && deviceNamesByIndex.TryGetValue(index, out var name) ? name : null;
        }
        private DeviceSettingsProfile CaptureDeviceSettings() => new DeviceSettingsProfile {
            SyncEnabled = syncEnabled, IntensityMultiplier = intensityMultiplier,
            OrgasmResponseEnabled = orgasmResponseEnabled, OrgasmSensitivity = orgasmSensitivity,
            OrgasmShotIntensity = orgasmShotIntensity, OrgasmShotPulseDuration = orgasmShotPulseDuration,
            OrgasmShotFadeDuration = orgasmShotFadeDuration, OrgasmShotOverrideMode = orgasmShotOverrideMode
        };
        private void ApplyDeviceSettings(DeviceSettingsProfile p)
        {
            syncEnabled = p.SyncEnabled; intensityMultiplier = p.IntensityMultiplier;
            orgasmResponseEnabled = p.OrgasmResponseEnabled; orgasmSensitivity = p.OrgasmSensitivity;
            orgasmShotIntensity = p.OrgasmShotIntensity; orgasmShotPulseDuration = p.OrgasmShotPulseDuration;
            orgasmShotFadeDuration = p.OrgasmShotFadeDuration; orgasmShotOverrideMode = p.OrgasmShotOverrideMode;
        }
        private void SwitchDeviceSettings(int index)
        {
            string key = DeviceSettingsKey(index);
            if (key == activeDeviceSettingsKey) return;
            if (activeDeviceSettingsKey != null) deviceSettings[activeDeviceSettingsKey] = CaptureDeviceSettings();
            if (key != null)
            {
                if (!deviceSettings.TryGetValue(key, out var settings))
                {
                    // Migrate the previous global settings to each device on first selection.
                    settings = CaptureDeviceSettings();
                    deviceSettings[key] = settings;
                }
                ApplyDeviceSettings(settings);
            }
            activeDeviceSettingsKey = key;
            if (key != null) SaveLovenseSettings();
            foreach (var pair in uiSliders)
                if (pair.Value != null) pair.Value.SetValueWithoutNotify(intensityMultiplier);
            RefreshLovenseIntensityLabels();
            foreach (var item in orgasmLiveSliders.ToArray())
            {
                if (item.Item1 == null) { orgasmLiveSliders.Remove(item); continue; }
                float value = item.Item2();
                item.Item1.SetValueWithoutNotify(value);
                if (item.Item3 != null) item.Item3.text = OrgasmDisplayValue(value, item.Item4);
            }
            foreach (var dropdown in orgasmModeDropdowns.ToArray())
            {
                if (dropdown == null) { orgasmModeDropdowns.Remove(dropdown); continue; }
                dropdown.SetValueWithoutNotify(orgasmShotOverrideMode == "Additive" ? 1 : 0);
                dropdown.RefreshShownValue();
            }
            SendBridgeSettings(true);
        }

