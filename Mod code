        private void LoadLovenseSettings()
        {
            try
            {
                if (!File.Exists(settingsFile)) return;
                foreach (var line in File.ReadAllLines(settingsFile))
                {
                    var pair = line.Split(new[] { '=' }, 2);
                    if (pair.Length != 2) continue;
                    if (pair[0].StartsWith("DeviceSettings_", StringComparison.Ordinal))
                    {
                        try
                        {
                            string name = Encoding.UTF8.GetString(Convert.FromBase64String(pair[0].Substring("DeviceSettings_".Length)));
                            var v = pair[1].Split('|');
                            if (v.Length == 8) deviceSettings[name] = new DeviceSettingsProfile {
                                SyncEnabled = bool.Parse(v[0]), IntensityMultiplier = float.Parse(v[1], CultureInfo.InvariantCulture),
                                OrgasmResponseEnabled = bool.Parse(v[2]), OrgasmSensitivity = float.Parse(v[3], CultureInfo.InvariantCulture),
                                OrgasmShotIntensity = float.Parse(v[4], CultureInfo.InvariantCulture),
                                OrgasmShotPulseDuration = float.Parse(v[5], CultureInfo.InvariantCulture),
                                OrgasmShotFadeDuration = float.Parse(v[6], CultureInfo.InvariantCulture),
                                OrgasmShotOverrideMode = v[7] == "Additive" ? "Additive" : "Override"
                            };
                        }
                        catch (Exception ex) { MelonLogger.Warning("[MDRG SETTINGS] Device profile load: " + ex.Message); }
                    }
                    if (pair[0].StartsWith("DeviceProfile_", StringComparison.Ordinal))
                    {
                        string key = pair[0].Substring("DeviceProfile_".Length);
                        var fields = pair[1].Split('|');
                        if (fields.Length == 13)
                        {
                            try
                            {
                                var p = new DeviceChannelProfile { Key = key };
                                p.Enabled = bool.Parse(fields[0]);
                                p.VibrationMultiplier = float.Parse(fields[1], CultureInfo.InvariantCulture);
                                p.VibrationCap = float.Parse(fields[2], CultureInfo.InvariantCulture);
                                p.Curve = float.Parse(fields[3], CultureInfo.InvariantCulture);
                                p.Smoothing = float.Parse(fields[4], CultureInfo.InvariantCulture);
                                p.StopFade = float.Parse(fields[5], CultureInfo.InvariantCulture);
                                p.ResponseSource = fields[6];
                                p.ZeroSpeedCutoff = bool.Parse(fields[7]);
                                p.IdleResponse = bool.Parse(fields[8]);
                                p.MinimumTravel = float.Parse(fields[9], CultureInfo.InvariantCulture);
                                p.MaximumTravel = float.Parse(fields[10], CultureInfo.InvariantCulture);
                                p.StrokeSmoothing = float.Parse(fields[11], CultureInfo.InvariantCulture);
                                p.ReverseStroke = bool.Parse(fields[12]);
                                motorProfiles[key] = p;
                            }
                            catch (Exception) { }
                        }
                    }
                    if (pair[0].Trim() == "SyncEnabled" && bool.TryParse(pair[1].Trim(), out bool b)) syncEnabled = b;
                    if (pair[0].Trim() == "OrgasmResponseEnabled" && bool.TryParse(pair[1].Trim(), out bool oe)) orgasmResponseEnabled = oe;
                    if (pair[0].Trim() == "MotorResponseEnabled" && bool.TryParse(pair[1].Trim(), out bool me)) motorResponseEnabled = me;
                    if (pair[0].Trim() == "OrgasmShotIntensity" && float.TryParse(pair[1].Trim(), NumberStyles.Float, CultureInfo.InvariantCulture, out float osi))
                        orgasmShotIntensity = Math.Max(0f, Math.Min(1f, osi));
                    if (pair[0].Trim() == "OrgasmShotPulseDuration" && float.TryParse(pair[1].Trim(), NumberStyles.Float, CultureInfo.InvariantCulture, out float opd))
                        orgasmShotPulseDuration = Math.Max(0f, Math.Min(1f, opd));
                    if (pair[0].Trim() == "OrgasmShotFadeDuration" && float.TryParse(pair[1].Trim(), NumberStyles.Float, CultureInfo.InvariantCulture, out float ofd))
                        orgasmShotFadeDuration = Math.Max(0f, Math.Min(1f, ofd));
                    if (pair[0].Trim() == "OrgasmShotOverrideMode")
                        orgasmShotOverrideMode = pair[1].Trim() == "Additive" ? "Additive" : "Override";
                    if (pair[0].Trim() == "OrgasmSensitivity" && float.TryParse(pair[1].Trim(), NumberStyles.Float, CultureInfo.InvariantCulture, out float os))
                        orgasmSensitivity = Math.Max(0f, Math.Min(1f, os));
                    if (pair[0].Trim() == "MotorIntensityLimit" && float.TryParse(pair[1].Trim(), NumberStyles.Float, CultureInfo.InvariantCulture, out float ml))
                        motorIntensityLimit = Math.Max(0f, Math.Min(1f, ml));
                    if (pair[0].Trim() == "IntensityMultiplier" && float.TryParse(pair[1].Trim(), NumberStyles.Float, CultureInfo.InvariantCulture, out float f))
                        intensityMultiplier = Math.Max(0f, Math.Min(1f, f));
                }
            }
            catch (Exception ex) { MelonLogger.Warning("[MDRG SETTINGS] Load failed: " + ex.Message); }
        }

        private string lastBridgeSettingsPayload;
        private void SendBridgeSettings(bool force = false)
        {
            if (sender == null || !sender.IsConnected) return;
            string snapshot = sender.LatestDeviceSnapshot;
            if (string.IsNullOrEmpty(snapshot) || !snapshot.StartsWith("DEVICE_SNAPSHOT|", StringComparison.Ordinal)) return;
            // Never send stale profile indices: resolve all channels against the current snapshot.
            var active = ReadMotorSnapshot();
            var payload = new {
                version = 1,
                syncEnabled,
                intensityMultiplier,
                deviceIntensities = deviceNamesByIndex.Select(entry => new {
                    DeviceIndex = entry.Key,
                    DeviceName = entry.Value,
                    IntensityMultiplier = activeDeviceSettingsKey == entry.Value
                        ? intensityMultiplier
                        : deviceSettings.TryGetValue(entry.Value, out var profile)
                            ? profile.IntensityMultiplier : intensityMultiplier
                }).ToArray(),
                orgasmResponseEnabled,
                orgasmSensitivity,
                orgasmShotIntensity,
                orgasmShotPulseDuration,
                orgasmShotFadeDuration,
                orgasmShotOverrideMode,
                channels = active.Select(p => new {
                    p.DeviceName, p.DeviceIndex, p.FeatureIndex, p.IsLinear,
                    p.Enabled, p.VibrationMultiplier, p.VibrationCap, p.Curve,
                    p.Smoothing, p.StopFade, p.ResponseSource,
                    p.ZeroSpeedCutoff, p.IdleResponse,
                    p.MinimumTravel, p.MaximumTravel, p.StrokeSmoothing, p.ReverseStroke
                }).ToArray()
            };
            string command = "BRIDGE_SETTINGS|" + Convert.ToBase64String(Encoding.UTF8.GetBytes(JsonSerializer.Serialize(payload)));
            if (force || command != lastBridgeSettingsPayload)
            {
                lastBridgeSettingsPayload = command;
                sender.Enqueue(command);
            }
        }

        private void SaveLovenseSettings()
        {
            try
            {
                Directory.CreateDirectory(Path.GetDirectoryName(settingsFile));
                var motorSettings = new System.Text.StringBuilder();
                foreach (var p in motorProfiles.Values)
                {
                    motorSettings.AppendLine("DeviceProfile_" + p.Key + "=" + string.Join("|", new[] {
                        p.Enabled.ToString(), p.VibrationMultiplier.ToString("R", CultureInfo.InvariantCulture),
                        p.VibrationCap.ToString("R", CultureInfo.InvariantCulture), p.Curve.ToString("R", CultureInfo.InvariantCulture),
                        p.Smoothing.ToString("R", CultureInfo.InvariantCulture), p.StopFade.ToString("R", CultureInfo.InvariantCulture),
                        p.ResponseSource, p.ZeroSpeedCutoff.ToString(), p.IdleResponse.ToString(),
                        p.MinimumTravel.ToString("R", CultureInfo.InvariantCulture),
                        p.MaximumTravel.ToString("R", CultureInfo.InvariantCulture),
                        p.StrokeSmoothing.ToString("R", CultureInfo.InvariantCulture), p.ReverseStroke.ToString() }));
                }
                if (activeDeviceSettingsKey != null) deviceSettings[activeDeviceSettingsKey] = CaptureDeviceSettings();
                var perDeviceSettings = new StringBuilder();
                foreach (var entry in deviceSettings)
                {
                    var v = entry.Value;
                    perDeviceSettings.AppendLine("DeviceSettings_" + Convert.ToBase64String(Encoding.UTF8.GetBytes(entry.Key)) + "=" +
                        string.Join("|", new[] { v.SyncEnabled.ToString(), v.IntensityMultiplier.ToString("R", CultureInfo.InvariantCulture),
                            v.OrgasmResponseEnabled.ToString(), v.OrgasmSensitivity.ToString("R", CultureInfo.InvariantCulture),
                            v.OrgasmShotIntensity.ToString("R", CultureInfo.InvariantCulture),
                            v.OrgasmShotPulseDuration.ToString("R", CultureInfo.InvariantCulture),
                            v.OrgasmShotFadeDuration.ToString("R", CultureInfo.InvariantCulture), v.OrgasmShotOverrideMode }));
                }
                File.WriteAllText(settingsFile, "SyncEnabled=" + syncEnabled + Environment.NewLine +
                    "IntensityMultiplier=" + intensityMultiplier.ToString("0.000", CultureInfo.InvariantCulture) + Environment.NewLine +
                    "OrgasmResponseEnabled=" + orgasmResponseEnabled + Environment.NewLine +
                    "OrgasmSensitivity=" + orgasmSensitivity.ToString("0.000", CultureInfo.InvariantCulture) + Environment.NewLine +
                    "OrgasmShotIntensity=" + orgasmShotIntensity.ToString("0.000", CultureInfo.InvariantCulture) + Environment.NewLine +
                    "OrgasmShotPulseDuration=" + orgasmShotPulseDuration.ToString("0.000", CultureInfo.InvariantCulture) + Environment.NewLine +
                    "OrgasmShotFadeDuration=" + orgasmShotFadeDuration.ToString("0.000", CultureInfo.InvariantCulture) + Environment.NewLine +
                    "OrgasmShotOverrideMode=" + orgasmShotOverrideMode + Environment.NewLine +
                    "MotorResponseEnabled=" + motorResponseEnabled + Environment.NewLine +
                    "MotorIntensityLimit=" + motorIntensityLimit.ToString("0.000", CultureInfo.InvariantCulture) + Environment.NewLine + perDeviceSettings.ToString() + motorSettings.ToString());
                SendBridgeSettings();
            }
            catch (Exception ex) { MelonLogger.Warning("[MDRG SETTINGS] Save failed: " + ex.Message); }
        }

        private static string FormatDetectedDevices(string snapshot)
        {
            if (string.IsNullOrEmpty(snapshot) || !snapshot.StartsWith("DEVICE_SNAPSHOT|", StringComparison.Ordinal))
                return "Detected devices: Waiting for device list...";
            try
            {
                using (var doc = JsonDocument.Parse(snapshot.Substring("DEVICE_SNAPSHOT|".Length)))
                {
                    if (doc.RootElement.ValueKind != JsonValueKind.Array) return "Detected devices: Invalid snapshot";
                    int count = doc.RootElement.GetArrayLength();
                    if (count == 0) return "No devices detected";
                    var names = new List<string>();
                    int shown = 0;
                    foreach (var device in doc.RootElement.EnumerateArray())
                    {
                        if (shown++ >= 3) break;
                        string name = device.TryGetProperty("name", out var n) ? n.GetString() ?? "Unknown device" : "Unknown device";
                        int index = device.TryGetProperty("index", out var ix) && ix.TryGetInt32(out int i) ? i : -1;
                        names.Add((index >= 0 ? "#" + index + " " : "") + name);
                    }
                    return "Detected devices (" + count + "): " + string.Join("  |  ", names) + (count > 3 ? "  +" + (count - 3) + " more" : "");
                }
            }
            catch (Exception) { return "Detected devices: Unable to read snapshot"; }
        }

