        {
            enableLogging = Config.Bind(
                "Diagnostics", "EnableLogging", true,
                "Write diagnostic reports.");

            enableTcp = Config.Bind(
                "Bridge", "EnableTcp", true,
                "Enable local TCP communication.");

            pollingInterval = Config.Bind(
                "Detection", "PollingInterval", 0.25f,
                "Seconds between controller scans.");

            transitionDelay = Config.Bind(
                "Detection", "TransitionDelay", 0.5f,
                "Controller transition grace period.");

            heartbeatInterval = Config.Bind(
                "Bridge", "HeartbeatInterval", 2f,
                "Seconds between heartbeats.");

            parameterInterval = Config.Bind(
                "Diagnostics", "ParameterInterval", 0.25f,
                "Seconds between parameter samples.");

            movementInterval = Config.Bind(
                "Diagnostics", "MovementInterval", 0.01f,
                "Seconds between movement samples (0.01-0.25). Can be edited while running; config reloads automatically.");

            minimumChange = Config.Bind(
                "Diagnostics", "MinimumParameterChange", 0.02f,
                "Minimum absolute parameter change to report.");

            maximumChanges = Config.Bind(
                "Diagnostics", "MaximumChangesPerSample", 30,
                "Maximum parameter changes logged per sample.");

            bridgeHost = Config.Bind(
                "Bridge", "Host", "127.0.0.1",
                "TCP bridge host.");

            bridgePort = Config.Bind(
                "Bridge", "Port", 45678,
                "TCP bridge port.");

            speedCap = Config.Bind("Simulation", "SpeedCap", 2.0f,
                "Speed at which simulated intensity reaches 100 percent.");
            smoothing = Config.Bind("Simulation", "Smoothing", 0.35f,
                "Smoothing factor per movement sample, from 0 to 1.");

            Config.Reload();
            settingsFile = Path.Combine(AppContext.BaseDirectory, "UserData", "MDRGLovenseSettings.cfg");
            LoadLovenseSettings();

            controllerReportPath = Path.Combine(
                AppContext.BaseDirectory,
                "MDRG_ControllerReport_v30.txt");

            parameterReportPath = Path.Combine(
                AppContext.BaseDirectory,
                "MDRG_ParameterReport_v30.txt");

            movementReportPath = Path.Combine(
                AppContext.BaseDirectory,
                "MDRG_MovementReport_v30.txt");

            sender = new TcpEventSender(
                enableTcp.Value,
                bridgeHost.Value,
                bridgePort.Value,
                WriteControllerReport);
            sender.Enqueue("INTIFACE_STATUS_REQUEST");

            ClassInjector.RegisterTypeInIl2Cpp<ControllerMonitor>();

            GameObject monitorObject =
                new GameObject("MDRG Controller Monitor");

            UnityEngine.Object.DontDestroyOnLoad(
                monitorObject);

            monitor =
                monitorObject.AddComponent<ControllerMonitor>();

            monitor.Initialize(
                Math.Max(0.1f, pollingInterval.Value),
                Math.Max(0f, transitionDelay.Value),
                Math.Max(0.5f, heartbeatInterval.Value),
                Math.Max(0.1f, parameterInterval.Value),
                Math.Max(0.01f, Math.Min(0.25f, movementInterval.Value)),
                Math.Max(0.0001f, minimumChange.Value),
                Math.Max(1, maximumChanges.Value),
                WriteControllerReport,
                WriteParameterReport,
                WriteMovementReport,
                OnControllerChanged,
                OnHeartbeat);

            monitor.ConfigureLiveSampling(() => {
                try
                {
                    string path = Config.ConfigFilePath;
                    if (!File.Exists(path)) return -1f;
                    var stamp = File.GetLastWriteTimeUtc(path);
                    if (stamp != lastSamplingConfigWrite)
                    {
                        lastSamplingConfigWrite = stamp;
                        Config.Reload();
                        return Math.Max(0.01f, Math.Min(0.25f, movementInterval.Value));
                    }
                }
                catch (Exception ex) { Log.LogWarning("Sampling reload failed: " + ex.Message); }
                return -1f;
            });

            monitor.ConfigureSimulation(
                Math.Max(0.01f, speedCap.Value),
                Math.Max(0f, Math.Min(1f, smoothing.Value)),
                OnSimulatedIntensity);

            monitor.ConfigureEjaculation(OnEjaculationEvent);

            sceneLoadedHandler = OnSceneLoaded;
            SceneManager.sceneLoaded += sceneLoadedHandler;

            Scene current = SceneManager.GetActiveScene();

            if (current.IsValid() && current.isLoaded)
                monitor.CheckScene();

            Log.LogInfo("MDRG Mod v3.3.41 device list loaded.");
        }


        public override void OnUpdate()
        {
            DiagnoseStockDropdown();
            if (bridgeLaunchPending && sender != null && sender.IsConnected)
            {
                bridgeLaunchPending = false;
                sender.Enqueue("INTIFACE_CONNECT");
                MelonLogger.Msg("[MDRG CONNECT] Bridge online; connecting to Intiface.");
            }
            if (bridgeLaunchPending && Time.unscaledTime - bridgeLaunchTime > 12f)
            {
                bridgeLaunchError = "Bridge startup timed out";
                StopOwnedBridge();
            }
            if (Time.unscaledTime >= nextWebsiteInspectionTime)
            {
                nextWebsiteInspectionTime = Time.unscaledTime + 3f;
                InspectRegisteredWebsites();
            }
            if (Time.unscaledTime >= nextSettingsRefresh)
            {
                nextSettingsRefresh = Time.unscaledTime + 0.15f;
                RefreshLovenseControls();
            }
            if (Time.unscaledTime >= nextPrototypeCheck)
            {
                nextPrototypeCheck = Time.unscaledTime + 0.75f;
                TryAttachNativePrototype();
            }
        }

        // Read-only diagnostic: inspects the live Stonks dropdown without modifying it.
        private void DiagnoseStockDropdown()
        {
            if (stockDropdownDiagnosticDone) return;
            try
            {
                var stocks = UnityEngine.Resources.FindObjectsOfTypeAll<StockWebsite>();
                foreach (var stock in stocks)
                {
                    if (stock == null || stock.gameObject == null || !stock.gameObject.activeInHierarchy) continue;
                    var dropdown = stock.companyDropdown;
                    if (dropdown == null || dropdown.gameObject == null) continue;
                    stockDropdownDiagnosticDone = true;
                    MelonLogger.Msg("[MDRG STONKS] Found dropdown: " + dropdown.gameObject.name);
                    Transform cursor = dropdown.transform;
                    string path = "";
                    for (int i = 0; cursor != null && i < 32; i++, cursor = cursor.parent)
                        path = "/" + cursor.name + path;
                    MelonLogger.Msg("[MDRG STONKS] Hierarchy: " + path);
                    MelonLogger.Msg("[MDRG STONKS] Template: " + (dropdown.template == null ? "null" : dropdown.template.name));
                    DumpStockDropdownTree(dropdown.transform, 0);
                    MelonLogger.Msg("[MDRG STONKS] Diagnostic complete; no objects changed.");
                    break;
                }
            }
            catch (Exception ex) { MelonLogger.Warning("[MDRG STONKS] Diagnostic failed: " + ex); stockDropdownDiagnosticDone = true; }
        }

        private static void DumpStockDropdownTree(Transform node, int depth)
        {
            if (node == null || depth > 7) return;
            string components = "";
            try
            {
                foreach (var component in node.gameObject.GetComponents<UnityEngine.Component>())
                {
                    if (component == null) continue;
                    if (components.Length > 0) components += ", ";
                    components += GetNativeComponentName(component);
                }
            }
            catch { }
            MelonLogger.Msg("[MDRG STONKS] " + new string(' ', depth * 2) + node.name + " [" + components + "]");
            for (int i = 0; i < node.childCount; i++) DumpStockDropdownTree(node.GetChild(i), depth + 1);
        }

