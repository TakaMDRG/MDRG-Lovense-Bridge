    public sealed class TcpEventSender : IDisposable
    {
        private readonly BlockingCollection<string> queue =
            new BlockingCollection<string>(
                new ConcurrentQueue<string>());

        private readonly bool enabled;
        private readonly string host;
        private readonly int port;
        private readonly Action<string> log;

        private bool? connected;
        private string lastDeviceSnapshot;
        private string lastIntifaceStatus;
        public string LatestIntifaceStatus => lastIntifaceStatus;
        public bool IsConnected => connected == true;
        public string LatestDeviceSnapshot => lastDeviceSnapshot;

        public void ResetBridgeState()
        {
            connected = false;
            lastIntifaceStatus = null;
            lastDeviceSnapshot = null;
        }

        public TcpEventSender(
            bool enabled,
            string host,
            int port,
            Action<string> log)
        {
            this.enabled = enabled;
            this.host = host;
            this.port = port;
            this.log = log;

            _ = Task.Run(ProcessQueue);
        }

        public void Enqueue(string message)
        {
            if (!enabled || queue.IsAddingCompleted)
                return;

            try
            {
                queue.Add(message);
            }
            catch (InvalidOperationException)
            {
            }
        }

        private void ProcessQueue()
        {
            foreach (string message in
                queue.GetConsumingEnumerable())
            {
                try
                {
                    using (var client = new TcpClient())
                    {
                        Task connect =
                            client.ConnectAsync(host, port);

                        if (!connect.Wait(
                            TimeSpan.FromSeconds(2)))
                        {
                            SetConnectionState(false);
                            continue;
                        }

                        using (NetworkStream stream =
                            client.GetStream())
                        {
                            byte[] bytes =
                                Encoding.UTF8.GetBytes(
                                    message + "\n");

                            stream.Write(
                                bytes, 0, bytes.Length);
                            if (message == "DEVICE_SNAPSHOT_REQUEST" ||
                                message == "INTIFACE_CONNECT" || message == "INTIFACE_DISCONNECT" ||
                                message == "INTIFACE_STATUS_REQUEST")
                            {
                                // Background worker only: never block Unity's main thread.
                                // The Intiface handshake may take several seconds; don't classify a slow reply as a TCP failure.
                                stream.ReadTimeout = message == "INTIFACE_CONNECT" ? 15000 : 5000;
                                using (var reader = new StreamReader(stream, Encoding.UTF8,
                                    false, 4096, true))
                                {
                                    string reply = reader.ReadLine();
                                    if (reply != null && reply.StartsWith("INTIFACE_STATUS|", StringComparison.Ordinal))
                                    {
                                        if (reply != lastIntifaceStatus) log?.Invoke("[INTIFACE STATUS] " + reply);
                                        lastIntifaceStatus = reply;
                                    }
                                    else if (reply != null && reply.StartsWith("DEVICE_SNAPSHOT|", StringComparison.Ordinal) && reply != lastDeviceSnapshot)
                                    {
                                        lastDeviceSnapshot = reply;
                                        log?.Invoke("[INTIFACE -> MDRG] " + reply);
                                    }
                                }
                            }
                        }
                    }

                    SetConnectionState(true);
                }
                catch (IOException ex)
                {
                    // A timed-out response does not prove the TCP bridge is offline.
                    // The next status poll can recover the authoritative state.
                    if (ex.InnerException is System.Net.Sockets.SocketException se &&
                        se.SocketErrorCode == SocketError.TimedOut)
                    {
                        log?.Invoke("Bridge reply timed out; waiting for status refresh.");
                    }
                    else SetConnectionState(false);
                }
                catch (Exception ex)
                {
                    log?.Invoke("Bridge request failed: " + ex.Message);
                    SetConnectionState(false);
                }
            }
        }

        private void SetConnectionState(bool state)
        {
            if (connected == state)
                return;

            connected = state;

            log?.Invoke(state
                ? "TCP bridge connected."
                : "TCP bridge unavailable.");
        }

        public void Dispose()
        {
            queue.CompleteAdding();
        }
    }

