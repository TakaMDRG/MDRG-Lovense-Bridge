        private bool OwnedBridgeRunning
        {
            get { try { return ownedBridgeProcess != null && !ownedBridgeProcess.HasExited; } catch { return false; } }
        }

        private void StopOwnedBridge()
        {
            bridgeLaunchPending = false;
            if (OwnedBridgeRunning)
            {
                try { ownedBridgeProcess.Kill(); ownedBridgeProcess.WaitForExit(2000); }
                catch (Exception ex) { MelonLogger.Warning("[MDRG CONNECT] Stop bridge: " + ex.Message); }
            }
            try { ownedBridgeProcess?.Dispose(); } catch { }
            ownedBridgeProcess = null;
        }

        private void RequestIntifaceConnection()
        {
            if (Time.unscaledTime - lastManualConnectRequest < 2f) return;
            lastManualConnectRequest = Time.unscaledTime;
            if (sender == null || !enableTcp.Value) return;
            bool connected = sender.LatestIntifaceStatus != null &&
                sender.LatestIntifaceStatus.StartsWith("INTIFACE_STATUS|CONNECTED|", StringComparison.Ordinal);
            if (connected || OwnedBridgeRunning || bridgeLaunchPending)
            {
                StopOwnedBridge();
                sender.ResetBridgeState();
                MelonLogger.Msg("[MDRG CONNECT] Disconnected; owned bridge stopped.");
            }
            else
            {
                // Never use the sender's cached TCP state to decide whether a bridge process exists.
                // It may still be true immediately after we terminate the owned process.
                sender.ResetBridgeState();
                try
                {
                    string executable = Path.Combine(AppContext.BaseDirectory, "Mods", "IntifaceBridge", "IntifaceConnectionTest.exe");
                    if (!File.Exists(executable)) throw new FileNotFoundException("Bridge executable missing", executable);
                    var info = new ProcessStartInfo(executable)
                    {
                        WorkingDirectory = Path.GetDirectoryName(executable),
                        UseShellExecute = false,
                        CreateNoWindow = true,
                        WindowStyle = ProcessWindowStyle.Hidden
                    };
                    info.EnvironmentVariables["MDRG_INTIFACE_URL"] = "ws://127.0.0.1:12345";
                    ownedBridgeProcess = Process.Start(info);
                    if (ownedBridgeProcess == null) throw new InvalidOperationException("Bridge process did not start.");
                    bridgeLaunchError = null;
                    bridgeLaunchPending = true;
                    bridgeLaunchTime = Time.unscaledTime;
                    MelonLogger.Msg("[MDRG CONNECT] Bridge launched PID=" + ownedBridgeProcess.Id);
                }
                catch (Exception ex)
                {
                    bridgeLaunchError = ex.Message;
                    MelonLogger.Warning("[MDRG CONNECT] " + ex);
                }
            }
            RefreshLovenseControls();
        }

