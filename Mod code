        private void ScanParameters(
            Transform current,
            ref int changeCount,
            ref int foundCount)
        {
            if (current == null ||
                !current.gameObject.activeInHierarchy)
                return;

            try
            {
                foreach (Component component in
                    current.gameObject.GetComponents<Component>())
                {
                    if (component == null)
                        continue;

                    Il2CppSystem.Type type =
                        component.GetIl2CppType();

                    if (type == null ||
                        type.Name != "CubismParameter")
                        continue;

                    foundCount++;

                    CubismParameter parameter =
                        component.TryCast<CubismParameter>();

                    if (parameter == null)
                        continue;

                    string id = parameter.Id;
                    float value = parameter.Value;

                    string path = GetObjectPath(current);
                    string key = path + "|" + id;

                    if (discoveredParameters.Add(key))
                    {
                        parameterLog?.Invoke(
                            "DISCOVERED | " +
                            id + " | " +
                            path + " | Value=" +
                            Format(value));
                    }

                    if (previousValues.TryGetValue(
                        key, out float previous))
                    {
                        float difference =
                            Math.Abs(value - previous);

                        if (difference >= minimumChange &&
                            changeCount < maximumChanges)
                        {
                            parameterLog?.Invoke(
                                "CHANGED | " +
                                id +
                                " | " + Format(previous) +
                                " -> " + Format(value) +
                                " | Delta=" +
                                Format(difference));

                            changeCount++;
                        }
                    }

                    previousValues[key] = value;
                }
            }
            catch (Exception ex)
            {
                parameterLog?.Invoke(
                    "Parameter object error: " +
                    ex.Message);
            }

            for (int i = 0; i < current.childCount; i++)
            {
                ScanParameters(
                    current.GetChild(i),
                    ref changeCount,
                    ref foundCount);
            }
        }

        private string GetObjectPath(Transform current)
        {
            string path = current.name;
            Transform parent = current.parent;

            while (parent != null)
            {
                path = parent.name + "/" + path;
                parent = parent.parent;
            }

            return path;
        }

        private void SetController(
            string key,
            string name)
        {
            if (key == currentControllerKey)
                return;

            string previous = currentControllerName;

            currentControllerKey = key;
            currentControllerName = name;

            previousEjaculation = null;
            warnedMissingUsage = false;
            warnedOtherController = false;
            previousValues.Clear();
            discoveredParameters.Clear();
            movementErrors.Clear();
            smoothedIntensity = 0f;
            hasSimulationSample = false;

            parameterLog?.Invoke(
                "CONTROLLER | " +
                (name == "" ? "None" : name));

            movementLog?.Invoke(
                "CONTROLLER | " +
                (name == "" ? "None" : name));

            onChanged?.Invoke(previous, name);
        }
    }
