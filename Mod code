        private void PublishSimulation(float speed, string controller, int handler, float rawPosition = 0f, bool positionValid = false)
        {
            if (float.IsNaN(speed) || float.IsInfinity(speed)) speed = 0f;
            float target = Math.Max(0f, Math.Min(1f, speed / speedCap));
            smoothedIntensity = hasSimulationSample
                ? smoothedIntensity + smoothing * (target - smoothedIntensity)
                : target;
            hasSimulationSample = true;
            onSimulation?.Invoke("SIM_INTENSITY|Controller=" + controller +
                "|Handler=" + handler +
                "|Speed=" + Format(speed) +
                "|Target=" + Format(target) +
                "|Smoothed=" + Format(smoothedIntensity) +
                "|PositionValid=" + (positionValid ? "1" : "0") +
                "|RawPosition=" + Format(positionValid ? rawPosition : 0f));
        }

        public void Update()
        {
            float now = Time.unscaledTime;

            if (now >= nextSamplingConfigCheck)
            {
                nextSamplingConfigCheck = now + 1f;
                float updated = sampleIntervalReload?.Invoke() ?? -1f;
                if (updated >= 0.01f && updated <= 0.25f)
                {
                    movementInterval = updated;
                    nextMovementTime = now + movementInterval;
                }
            }

            if (now >= nextCheckTime)
            {
                nextCheckTime = now + pollingInterval;
                CheckScene();
            }

            if (now >= nextEjaculationTime)
            {
                nextEjaculationTime = now + 0.02f;
                InspectEjaculation();
            }

            if (now >= nextHeartbeatTime)
            {
                nextHeartbeatTime = now + heartbeatInterval;

                if (IsMainScene())
                    onHeartbeat?.Invoke();
            }

            if (now >= nextParameterTime)
            {
                nextParameterTime = now + parameterInterval;
                InspectParameters();
            }

            if (now >= nextMovementTime)
            {
                nextMovementTime = now + movementInterval;
                InspectMovement();
            }
        }

        private bool IsMainScene()
        {
            Scene scene = SceneManager.GetActiveScene();

            return scene.IsValid() &&
                   scene.isLoaded &&
                   scene.name == "MainScene";
        }

        public void CheckScene()
        {
            if (!IsMainScene())
            {
                missingSince = -1f;
                SetController("", "");
                return;
            }

            candidates.Clear();

            try
            {
                Scene scene = SceneManager.GetActiveScene();

                foreach (GameObject root
                    in scene.GetRootGameObjects())
                {
                    FindControllers(root.transform);
                }

                string selectedKey = "";
                string selectedName = "";

                foreach (var entry in candidates)
                {
                    Component component = entry.Value;

                    if (component == null)
                        continue;

                    Behaviour behaviour =
                        component.TryCast<Behaviour>();

                    if (behaviour == null ||
                        !behaviour.isActiveAndEnabled)
                        continue;

                    string name =
                        component.GetIl2CppType().Name;

                    if (entry.Key == currentControllerKey)
                    {
                        selectedKey = entry.Key;
                        selectedName = name;
                        break;
                    }

                    if (selectedKey == "")
                    {
                        selectedKey = entry.Key;
                        selectedName = name;
                    }
                }

                if (selectedKey != "")
                {
                    missingSince = -1f;
                    SetController(selectedKey, selectedName);
                }
                else if (currentControllerKey != "")
                {
                    if (missingSince < 0f)
                        missingSince = Time.unscaledTime;

                    if (Time.unscaledTime -
                        missingSince >= transitionDelay)
                    {
                        SetController("", "");
                        missingSince = -1f;
                    }
                }
            }
            catch (Exception ex)
            {
                log?.Invoke(
                    "Controller scan error: " +
                    ex.Message);
            }
        }

        private void FindControllers(Transform current)
        {
            if (current == null)
                return;

            try
            {
                foreach (Component component in
                    current.gameObject.GetComponents<Component>())
                {
                    if (component == null)
                        continue;

                    Il2CppSystem.Type type =
                        component.GetIl2CppType();

                    if (type == null)
                        continue;

                    string name = type.Name;

                    if (!name.StartsWith("Live2D") ||
                        !name.EndsWith("Controller"))
                        continue;

                    string key =
                        GetObjectPath(current) + "|" + name;

                    candidates[key] = component;
                }
            }
            catch (Exception ex)
            {
                log?.Invoke(
                    "Controller scan error: " +
                    ex.Message);
            }

            for (int i = 0; i < current.childCount; i++)
                FindControllers(current.GetChild(i));
        }


