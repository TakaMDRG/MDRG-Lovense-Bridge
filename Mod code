    // Lightweight INI-compatible settings layer; no BepInEx dependency.
    public sealed class ConfigEntry<T>
    {
        public T Value { get; internal set; }
        internal readonly T DefaultValue;
        internal ConfigEntry(T value) { Value = value; DefaultValue = value; }
    }

    public sealed class LocalConfig
    {
        private readonly Dictionary<string, object> entries = new Dictionary<string, object>();
        public string ConfigFilePath { get; } = Path.Combine(AppContext.BaseDirectory, "UserData", "MDRGMod.cfg");

        public ConfigEntry<T> Bind<T>(string section, string key, T defaultValue, string description)
        {
            var entry = new ConfigEntry<T>(defaultValue);
            entries[section + "." + key] = entry;
            return entry;
        }

        public void Reload()
        {
            if (!File.Exists(ConfigFilePath)) { SaveDefaults(); return; }
            string section = "";
            foreach (var raw in File.ReadAllLines(ConfigFilePath))
            {
                var line = raw.Trim();
                if (line.Length == 0 || line.StartsWith("#") || line.StartsWith(";")) continue;
                if (line.StartsWith("[") && line.EndsWith("]")) { section = line.Substring(1, line.Length - 2); continue; }
                int eq = line.IndexOf('=');
                if (eq < 0) continue;
                string name = section + "." + line.Substring(0, eq).Trim();
                if (!entries.TryGetValue(name, out object item)) continue;
                string value = line.Substring(eq + 1).Trim();
                try
                {
                    var prop = item.GetType().GetProperty("Value");
                    // Value uses an internal setter and can be updated via reflection.
                    var type = prop.PropertyType;
                    object parsed = type == typeof(bool) ? bool.Parse(value)
                        : type == typeof(float) ? float.Parse(value, CultureInfo.InvariantCulture)
                        : type == typeof(int) ? int.Parse(value, CultureInfo.InvariantCulture)
                        : (object)value;
                    prop.SetValue(item, parsed);
                }
                catch { }
            }
        }

        private void SaveDefaults()
        {
            Directory.CreateDirectory(Path.GetDirectoryName(ConfigFilePath));
            using var writer = new StreamWriter(ConfigFilePath);
            string section = null;
            foreach (var pair in entries)
            {
                int split = pair.Key.IndexOf('.');
                string next = pair.Key.Substring(0, split);
                if (next != section) { section = next; writer.WriteLine("[" + section + "]"); }
                var val = pair.Value.GetType().GetProperty("Value").GetValue(pair.Value);
                writer.WriteLine(pair.Key.Substring(split + 1) + " = " + Convert.ToString(val, CultureInfo.InvariantCulture));
            }
        }
    }

