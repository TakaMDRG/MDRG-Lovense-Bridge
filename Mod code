        private void InspectWebsiteObject(object value, string label, bool inspectType)
        {
            if (value == null) return;
            try
            {
                var type = value.GetType();
                const BindingFlags flags = BindingFlags.Public | BindingFlags.Instance;
                if (inspectType && inspectedWebsiteTypes.Add(type.FullName ?? type.Name))
                {
                    MelonLogger.Msg("[MDRG WEBSITE] TYPE " + label + "=" + type.FullName);
                    foreach (var field in type.GetFields(flags))
                        MelonLogger.Msg("[MDRG WEBSITE]   FIELD " + field.FieldType.Name + " " + field.Name);
                    foreach (var property in type.GetProperties(flags))
                        MelonLogger.Msg("[MDRG WEBSITE]   PROPERTY " + property.PropertyType.Name + " " + property.Name);
                    foreach (var method in type.GetMethods(flags))
                    {
                        if (method.IsSpecialName) continue;
                        MelonLogger.Msg("[MDRG WEBSITE]   METHOD " + method.ReturnType.Name + " " + method.Name);
                    }
                }
                foreach (var field in type.GetFields(flags))
                {
                    try
                    {
                        object result = field.GetValue(value);
                        if (result == null || result is string || result.GetType().IsPrimitive || result.GetType().IsEnum)
                            MelonLogger.Msg("[MDRG WEBSITE] " + label + "." + field.Name + "=" + (result ?? "(null)"));
                    }
                    catch { }
                }
                foreach (var property in type.GetProperties(flags))
                {
                    if (property.GetIndexParameters().Length != 0 || property.GetGetMethod() == null) continue;
                    try
                    {
                        object result = property.GetValue(value);
                        if (result == null || result is string || result.GetType().IsPrimitive || result.GetType().IsEnum)
                            MelonLogger.Msg("[MDRG WEBSITE] " + label + "." + property.Name + "=" + (result ?? "(null)"));
                    }
                    catch { }
                }
            }
            catch (Exception ex)
            {
                MelonLogger.Warning("[MDRG WEBSITE] " + label + " inspection failed: " + ex.Message);
            }
        }

