        private void ShowLovenseTab(int id, int tab)
        {
            if (!lovenseTabPanels.TryGetValue(id, out var panels)) return;
            lovenseActiveTabs[id] = tab;
            if (lovenseTabIcons.TryGetValue(id, out var icons))
            {
                for (int i = 0; i < icons.Length; i++)
                    if (icons[i] != null) icons[i].color = i == tab
                        ? new Color(.98f, .23f, .59f, 1f)
                        : new Color(.76f, .81f, .91f, 1f);
            }
            if (lovenseTabButtonImages.TryGetValue(id, out var buttons))
            {
                for (int i = 0; i < buttons.Length; i++)
                    if (buttons[i] != null) buttons[i].color = i == tab
                        ? new Color(.235f, .15f, .265f, 1f)
                        : new Color(.092f, .135f, .213f, 1f);
            }
            if (lovenseTabAccentImages.TryGetValue(id, out var accent) && accent != null)
            {
                PositionPreview(accent.transform, (tab - 1) * 325f, -43f, 324f, 4f);
            }
            for (int i = 0; i < panels.Length; i++)
                if (panels[i] != null) panels[i].SetActive(i == tab);
            MelonLogger.Msg("[MDRG TABS] Selected " + (tab == 0 ? "Penetration" : tab == 1 ? "Orgasm Controls" : "Motors") + " (UI only)");
        }
        private void AddLovenseTabButton(GameObject buttonSource, Transform parent, int id, int tab, string caption, float x)
        {
            var clone = UnityEngine.Object.Instantiate(buttonSource, parent, false);
            clone.name = "Lovense Tab - " + caption;
            DisablePreviewBehaviours(clone);
            PositionPreview(clone.transform, x, -14f, 325f, 54f);
            LovenseButtonStyle(clone, tab == 0 ? new Color(.235f, .15f, .265f, 1f) : new Color(.092f, .135f, .213f, 1f));
            var text = clone.transform.Find("Text (TMP)");
            if (text != null) SetPreviewText(text.gameObject, caption, 19f);
            if (!lovenseTabIcons.TryGetValue(id, out var tabIcons))
            {
                tabIcons = new UnityEngine.UI.Image[3];
                lovenseTabIcons[id] = tabIcons;
            }
            tabIcons[tab] = LovenseIcon(parent, "Tab Icon " + caption, x - 119f, -14f, tab == 0 ? 2 : tab == 1 ? 3 : 4);
            if (!lovenseTabButtonImages.TryGetValue(id, out var tabButtons))
            {
                tabButtons = new UnityEngine.UI.Image[3];
                lovenseTabButtonImages[id] = tabButtons;
            }
            tabButtons[tab] = clone.GetComponent<UnityEngine.UI.Image>();
            var button = clone.GetComponent<UnityEngine.UI.Button>();
            if (button != null)
            {
                button.onClick = new UnityEngine.UI.Button.ButtonClickedEvent();
                button.onClick.AddListener(Il2CppInterop.Runtime.DelegateSupport.ConvertDelegate<UnityEngine.Events.UnityAction>(
                    new System.Action(() => ShowLovenseTab(id, tab))));
                button.enabled = true;
            }
        }
