    static async Task ListenForGame(
        TcpListener listener,
        CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            TcpClient client;

            try
            {
                client =
                    await listener.AcceptTcpClientAsync(token);
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch (SocketException) when (
                token.IsCancellationRequested)
            {
                break;
            }

            _ = HandleGameClient(client, token);
        }
    }

    // Reply to the game's explicit request on the same loopback TCP connection.
    // Intiface remains the source of truth; no physical-output commands are changed.
    static string BuildDeviceSnapshot()
    {
        lock (DeviceLock)
        {
            var devices = Devices.Values.OrderBy(d => d.Index)
                .Select(d => new {
                    index = d.Index,
                    name = d.Name,
                    vibrationFeatures = d.VibrationFeatures,
                    vibrationIndices = d.VibrationIndices.ToArray(),
                    linearIndices = d.LinearIndices.ToArray()
                }).ToArray();
            return "DEVICE_SNAPSHOT|" + JsonSerializer.Serialize(devices);
        }
    }

    static async Task WriteBridgeReply(TcpClient client, string reply, CancellationToken token)
    {
        byte[] payload = Encoding.UTF8.GetBytes(reply + "\n");
        await client.GetStream().WriteAsync(payload, token);
    }

    // UI settings are configuration only: receiving them never arms or starts output.
    // Physical-output multipliers are keyed by Intiface device index, not by the UI selection.
    private static readonly Dictionary<int, double> websiteIntensityByDevice = new();
    static void ApplyGameSettings(string encoded)
    {
        try
        {
            if (encoded.Length > 65536) return;
            using var json = JsonDocument.Parse(Convert.FromBase64String(encoded));
            var root = json.RootElement;
            if (!root.TryGetProperty("version", out var version) || version.GetInt32() != 1) return;
            bool Bool(JsonElement obj, string key, bool fallback) =>
                obj.TryGetProperty(key, out var v) && (v.ValueKind == JsonValueKind.True || v.ValueKind == JsonValueKind.False) ? v.GetBoolean() : fallback;
            double Number(JsonElement obj, string key, double fallback, double min, double max) =>
                obj.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number &&
                v.TryGetDouble(out double n) && double.IsFinite(n) && n >= min && n <= max ? n : fallback;
            string String(JsonElement obj, string key, string fallback) =>
                obj.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? fallback : fallback;
            // A disabled sync switch prevents the website from changing live device settings.
            if (!Bool(root, "syncEnabled", false)) return;
            if (!root.TryGetProperty("channels", out var channels) || channels.ValueKind != JsonValueKind.Array) return;
            lock (DeviceLock)
            lock (SimulationLock)
            {
                // A complete device snapshot is sent on every settings update.
                // Validate the index AND name before accepting each multiplier.
                // Missing entries default to unity, never to another device's value.
                websiteIntensityByDevice.Clear();
                if (root.TryGetProperty("deviceIntensities", out var perDevice) &&
                    perDevice.ValueKind == JsonValueKind.Array)
                {
                    foreach (var entry in perDevice.EnumerateArray())
                    {
                        if (entry.ValueKind != JsonValueKind.Object ||
                            !entry.TryGetProperty("DeviceIndex", out var indexValue) ||
                            !indexValue.TryGetInt32(out int index) ||
                            !Devices.TryGetValue(index, out var device) ||
                            device.Name != String(entry, "DeviceName", "")) continue;
                        websiteIntensityByDevice[index] = Number(entry, "IntensityMultiplier", 1.0, 0, 1);
                    }
                }
                foreach (var item in channels.EnumerateArray())
                {
                    if (!item.TryGetProperty("DeviceIndex", out var d) || !d.TryGetInt32(out int deviceIndex) ||
                        !item.TryGetProperty("FeatureIndex", out var f) || !f.TryGetInt32(out int featureIndex)) continue;
                    string deviceName = String(item, "DeviceName", "");
                    if (!Devices.TryGetValue(deviceIndex, out var device) || device.Name != deviceName) continue;
                    bool linear = Bool(item, "IsLinear", false);
                    if (linear)
                    {
                        if (!device.LinearIndices.Contains(featureIndex)) continue;
                        var a = LinearAxes.FirstOrDefault(x => x.DeviceIndex == deviceIndex && x.FeatureIndex == featureIndex);
                        if (a == null) continue;
                        a.Enabled = Bool(item, "Enabled", a.Enabled);
                        double min = Number(item, "MinimumTravel", a.Min, 0, 1);
                        double max = Number(item, "MaximumTravel", a.Max, 0, 1);
                        if (min < max) { a.Min = min; a.Max = max; }
                        a.WaveSmoothSeconds = Number(item, "StrokeSmoothing", a.WaveSmoothSeconds, 0, 1);
                        a.Reverse = Bool(item, "ReverseStroke", a.Reverse);
                        a.LastPosition = double.NaN;
                    }
                    else
                    {
                        if (!device.VibrationIndices.Contains(featureIndex)) continue;
                        var m = Motors.FirstOrDefault(x => x.DeviceIndex == deviceIndex && x.FeatureIndex == featureIndex);
                        if (m == null) continue;
                        m.Enabled = Bool(item, "Enabled", m.Enabled);
                        m.Multiplier = Number(item, "VibrationMultiplier", m.Multiplier, 0, 2);
                        m.MaxPercent = Number(item, "VibrationCap", m.MaxPercent / 100, 0, 1) * 100;
                        m.DepthCurve = Number(item, "Curve", m.DepthCurve, 0.5, 4);
                        m.SmoothSeconds = Number(item, "Smoothing", m.SmoothSeconds, 0, 1);
                        m.StopFadeSeconds = Number(item, "StopFade", m.StopFadeSeconds, 0, 1);
                        string source = String(item, "ResponseSource", m.Source).ToLowerInvariant();
                        if (source is "hybrid" or "depth" or "speed") m.Source = source;
                        m.StopOnZeroSpeed = Bool(item, "ZeroSpeedCutoff", m.StopOnZeroSpeed);
                        m.IdleEnabled = Bool(item, "IdleResponse", m.IdleEnabled);
                        bool orgasm = Bool(root, "orgasmResponseEnabled", true);
                        m.EjacMode = orgasm ? (String(root, "orgasmShotOverrideMode", "Override") == "Additive" ? "shot-additive" : "shot-override") : "off";
                        m.EjacIntensity = Number(root, "orgasmShotIntensity", m.EjacIntensity / 100, 0, 1) * 100 * Number(root, "orgasmSensitivity", 0.5, 0, 1);
                        m.EjacPulse = Number(root, "orgasmShotPulseDuration", m.EjacPulse, 0.05, 1);
                        m.EjacFade = Number(root, "orgasmShotFadeDuration", m.EjacFade, 0, 1);
                    }
                }
            }
            Console.WriteLine("[SETTINGS] Applied validated settings to detected actuators; output arming unchanged.");
        }
        catch (Exception ex) { Console.WriteLine("[SETTINGS] Ignored invalid payload: " + ex.Message); }
    }

    static async Task HandleGameClient(
        TcpClient client,
        CancellationToken token)
    {
        using (client)
        {
            try
            {
                using var reader = new StreamReader(
                    client.GetStream(),
                    Encoding.UTF8);

                while (!token.IsCancellationRequested)
                {
                    string? line =
                        await reader.ReadLineAsync(token);

                    if (line == null)
                        break;

                    if (line == "INTIFACE_CONNECT")
                    {
                        await ConnectIntiface();
                        await WriteBridgeReply(client, ConnectionReply(), token);
                        continue;
                    }
                    if (line == "INTIFACE_DISCONNECT")
                    {
                        await DisconnectIntiface();
                        await WriteBridgeReply(client, ConnectionReply(), token);
                        continue;
                    }
                    if (line == "INTIFACE_STATUS_REQUEST")
                    {
                        await WriteBridgeReply(client, ConnectionReply(), token);
                        continue;
                    }
                    if (line.StartsWith("BRIDGE_SETTINGS|", StringComparison.Ordinal))
                    {
                        ApplyGameSettings(line.Substring("BRIDGE_SETTINGS|".Length));
                        continue;
                    }
                    if (line == "DEVICE_SNAPSHOT_REQUEST")
                    {
                        await WriteBridgeReply(client, BuildDeviceSnapshot(), token);
                        continue;
                    }
                    ProcessGameEvent(line);
                }
            }
            catch (OperationCanceledException)
            {
            }
            catch (IOException)
            {
            }
        }
    }

