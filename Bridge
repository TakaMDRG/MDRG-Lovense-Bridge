    // A motor's selected source is evaluated only after all existing output safety checks.
    // Hybrid: 60% speed + 40% depth, with movement gating so stationary output fades to zero.
    // Idle is optional and only applies when insertion is valid and nonzero.
    static double SelectedMotorPercent(MotorSetting m)
    {
        double speedPercent = Math.Clamp(movementTarget, 0, 100);
        // Shower has no validated depth calibration. Use speed as a
        // shower-only fallback for depth-dependent motor modes.
        if (movementController == "Live2DShowerController" &&
            (m.Source == "hybrid" || m.Source == "blend" || m.Source == "depth"))
            // A steeper curve emphasizes acceleration and deceleration without
            // increasing the configured maximum output.
            return movementSpeed < ZeroSpeedThreshold ? 0 :
                100.0 * Math.Pow(speedPercent / 100.0, 1.8);
        // Blowjob-only speed response: 1.5x speed sensitivity, capped at 100%.
        // This affects speed, hybrid, and blend modes; depth-only remains depth-driven.
        if (movementController == "Live2DBlowjobController")
            speedPercent = Math.Clamp(speedPercent * 1.5, 0, 100);
        double depthFraction = normalizedDepthValid
            ? Math.Pow(Math.Clamp(normalizedDepth / 100.0, 0, 1), m.DepthCurve) : 0;
        double depthPercent = 100.0 * depthFraction;
        bool withdrawn = !normalizedDepthValid || normalizedDepth <= 1.0;
        if ((m.Source == "depth" || m.Source == "hybrid" || m.Source == "blend") && withdrawn) return 0;
        if (m.Source == "hybrid")
        {
            // Speed cutoff avoids a residual target holding the motor on.
            double speedFraction = movementSpeed < ZeroSpeedThreshold ? 0 : speedPercent / 100.0;
            double depthGate = Math.Pow(Math.Clamp(normalizedDepth / 100.0, 0, 1), m.HybridDepthGate);
            double active = speedFraction > 0
                ? speedPercent * m.BlendSpeedWeight * depthGate + depthPercent * (1.0 - m.BlendSpeedWeight)
                : 0;
            return active > 0 ? active : (m.IdleEnabled ? m.IdlePercent * depthFraction : 0);
        }
        if ((m.Source == "speed" || m.StopOnZeroSpeed) && movementSpeed < ZeroSpeedThreshold) return 0;
        return m.Source switch
        {
            "depth" => movementSpeed < ZeroSpeedThreshold ? (m.IdleEnabled ? m.IdlePercent * depthFraction : 0) : depthPercent,
            "blend" => speedPercent * m.BlendSpeedWeight * Math.Pow(Math.Clamp(normalizedDepth / 100.0, 0, 1), m.HybridDepthGate) + depthPercent * (1 - m.BlendSpeedWeight),
            _ => speedPercent
        };
    }

