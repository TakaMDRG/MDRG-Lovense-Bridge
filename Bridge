    static bool ConfigureLinear(string command)
    {
        var parts=command.Split(' ',StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0 || !parts[0].Equals("linear",StringComparison.OrdinalIgnoreCase)) return false;
        if (parts.Length != 4 && parts.Length != 3)
        { Console.WriteLine("[LINEAR] Usage: linear N on|off OR linear N min|max|duration|reverse|wavesmooth VALUE"); return true; }
        if (!int.TryParse(parts[1],out int n)) { Console.WriteLine("[LINEAR] Invalid index"); return true; }
        lock (SimulationLock)
        {
            if (n<1 || n>LinearAxes.Count) { Console.WriteLine("[LINEAR] Axis not found. Use linears."); return true; }
            var a=LinearAxes[n-1];
            string field=parts[2].ToLowerInvariant();
            string value=parts.Length==3 ? field : parts[3].ToLowerInvariant();
            bool? boolean=value is "on" or "1" or "true" ? true : value is "off" or "0" or "false" ? false : null;
            if (parts.Length==3 && boolean.HasValue) { a.Enabled=boolean.Value; a.LastPosition=double.NaN; }
            else if (field=="reverse" && boolean.HasValue) a.Reverse=boolean.Value;
            else if (double.TryParse(value,NumberStyles.Float,CultureInfo.InvariantCulture,out double v))
            {
                if (field=="min" && v>=0 && v<=100 && v/100<a.Max) a.Min=v/100;
                else if (field=="max" && v>=0 && v<=100 && v/100>a.Min) a.Max=v/100;
                else if (field=="duration" && v>=50 && v<=2000) a.DurationMs=(int)v;
                else if (field=="wavesmooth" && v>=0 && v<=1) a.WaveSmoothSeconds=v;
                else Console.WriteLine("[LINEAR] Invalid range or value");
            }
            else Console.WriteLine("[LINEAR] Invalid command");
            Console.WriteLine($"[LINEAR] {a.Name} enabled={a.Enabled} range={a.Min:P0}..{a.Max:P0} reverse={a.Reverse} duration={a.DurationMs}ms wavesmooth={a.WaveSmoothSeconds:F2}s");
        }
        return true;
    }
    static void RefreshMotorMappings()
    {
        List<(int index, string name, int[] features)> devices;
        lock (DeviceLock)
            devices = Devices.Values.OrderBy(d => d.Index)
                .Select(d => (d.Index, d.Name, d.VibrationIndices.ToArray())).ToList();
        lock (SimulationLock)
        {
            var old = Motors.ToDictionary(m => $"{m.DeviceIndex}:{m.FeatureIndex}");
            Motors.Clear();
            foreach (var d in devices)
                foreach (int feature in d.features)
                {
                    string key = $"{d.index}:{feature}";
                    if (old.TryGetValue(key, out var existing))
                    { existing.Name = d.name + (d.features.Length > 1 ? $" / vibration {feature+1}" : ""); Motors.Add(existing); }
                    else Motors.Add(new MotorSetting(d.name + (d.features.Length > 1 ? $" / vibration {feature+1}" : ""), d.index, feature));
                }
        }
        lock (DeviceLock)
        lock (SimulationLock)
        {
            var old=LinearAxes.ToDictionary(a=>$"{a.DeviceIndex}:{a.FeatureIndex}");
            LinearAxes.Clear();
            foreach (var d in Devices.Values.OrderBy(d=>d.Index))
                foreach (int index in d.LinearIndices)
                {
                    string key=$"{d.Index}:{index}";
                    if (old.TryGetValue(key,out var previous))
                    { previous.Name=d.Name; LinearAxes.Add(previous); }
                    else LinearAxes.Add(new LinearSetting(d.Name,d.Index,index));
                }
        }
        Console.WriteLine($"[INTIFACE] Mapped {Motors.Count} vibration channels and {LinearAxes.Count} linear axes. Use motors / linears.");
    }

    static DeviceInfo ParseDevice(JsonElement device)
    {
        var info = new DeviceInfo
        {
            Index = device.GetProperty(
                "DeviceIndex").GetInt32(),

            Name = device.GetProperty(
                "DeviceName").GetString()
                ?? "Unknown device"
        };

        if (device.TryGetProperty(
            "DeviceMessages", out JsonElement messages) &&
            messages.TryGetProperty(
                "ScalarCmd", out JsonElement commands))
        {
            int scalarIndex = 0;
            foreach (JsonElement command in
                commands.EnumerateArray())
            {
                string actuator =
                    command.GetProperty("ActuatorType")
                        .GetString() ?? "";

                if (actuator.Equals(
                    "Vibrate",
                    StringComparison.OrdinalIgnoreCase))
                {
                    info.VibrationFeatures++;
                    info.VibrationIndices.Add(scalarIndex);

                    if (command.TryGetProperty(
                        "StepCount", out JsonElement steps))
                    {
                        info.StepCounts.Add(steps.GetInt32());
                    }
                }
                scalarIndex++;
            }
        }

        if (device.TryGetProperty("DeviceMessages",out JsonElement linearMessages) &&
            linearMessages.TryGetProperty("LinearCmd",out JsonElement linearCommands) &&
            linearCommands.ValueKind==JsonValueKind.Array)
        {
            for(int i=0;i<linearCommands.GetArrayLength();i++) info.LinearIndices.Add(i);
        }
        return info;
    }

