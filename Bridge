    static async Task ReadCommands(
        CancellationTokenSource cancellation)
    {
        while (!cancellation.IsCancellationRequested)
        {
            string? command =
                await Task.Run(() => Console.ReadLine());

            if (command == null)
                break;

            command = command.Trim();

            if (command.Equals(
                "quit", StringComparison.OrdinalIgnoreCase))
                break;

            if (command.Equals(
                "help", StringComparison.OrdinalIgnoreCase))
            {
                PrintHelp();
                continue;
            }

            if (command.Equals("connect", StringComparison.OrdinalIgnoreCase))
            { await ConnectIntiface(); Console.WriteLine(ConnectionReply()); continue; }
            if (command.Equals("disconnect", StringComparison.OrdinalIgnoreCase))
            { await DisconnectIntiface(); Console.WriteLine(ConnectionReply()); continue; }

            if (command.Equals(
                "list", StringComparison.OrdinalIgnoreCase))
            {
                PrintDevices();
                continue;
            }

            if (command.Equals(
                "status", StringComparison.OrdinalIgnoreCase))
            {
                PrintStatus();
                continue;
            }

            if (command.Equals("logpath", StringComparison.OrdinalIgnoreCase))
            {
                Console.WriteLine("[LOG] " + (movementLog == null ? "Unavailable" : movementLogPath));
                continue;
            }
            if (command.Equals("armstatus", StringComparison.OrdinalIgnoreCase))
            {
                PrintArmingDiagnostics();
                continue;
            }
            if (command.Equals("depthstats", StringComparison.OrdinalIgnoreCase))
            {
                PrintDepthStats();
                continue;
            }
            if (command.Equals("depthreset", StringComparison.OrdinalIgnoreCase))
            {
                lock (SimulationLock)
                {
                    DepthByController.Clear();
                    DepthByHandler.Clear();
                }
                Console.WriteLine("[DEPTH] Diagnostic history cleared; physical output unchanged.");
                continue;
            }
            if (command.Equals("motors", StringComparison.OrdinalIgnoreCase))
            {
                PrintMotors();
                continue;
            }
            if (command.Equals("linears", StringComparison.OrdinalIgnoreCase))
            { PrintLinears(); continue; }
            if (ConfigureLinear(command)) continue;
            if (ConfigureMotor(command)) continue;
            if (command.Equals("stop", StringComparison.OrdinalIgnoreCase) ||
                command.Equals("disarm", StringComparison.OrdinalIgnoreCase))
            {
                lock (SimulationLock)
                {
                    physicalArmed = false;
                    emergencyStopped = true;
                    autoArmBlocked = true;
                    pauseStarted = DateTime.MinValue;
                    currentIntensity = 0;
                    targetIntensity = 0;
                }
                if (activeSocket is { State: WebSocketState.Open } liveSocket)
                    await SendGushZero(liveSocket, cancellation.Token);
                Console.WriteLine("[STOP] All detected vibration channels zeroed; output DISARMED.");
                continue;
            }
            if (command.Equals("arm", StringComparison.OrdinalIgnoreCase) || command.Equals("arm gush", StringComparison.OrdinalIgnoreCase))
            {
                lock (SimulationLock)
                {
                    bool fresh = receivingMovement && gameActive &&
                        (DateTime.UtcNow-lastIntensityUpdate).TotalSeconds < 1 &&
                        (DateTime.UtcNow-lastGameHeartbeat).TotalSeconds < HeartbeatDisconnectSeconds;
                    if (fresh && !emergencyStopped && !autoArmBlocked && outputLoopHealthy && (Motors.Exists(m => m.Enabled) || LinearAxes.Exists(a => a.Enabled)))
                    { physicalArmed = true; Console.WriteLine("[ARMED] Detected vibration channels enabled."); }
                    else Console.WriteLine("[ARM DENIED] Need fresh game telemetry, an enabled channel, and no stop latch. Try resume.");
                }
                continue;
            }
            if (command.Equals("resume", StringComparison.OrdinalIgnoreCase))
            {
                lock (SimulationLock) { emergencyStopped = false; autoArmBlocked = false; }
                Console.WriteLine("[RESUME] Stop latch cleared. Automatic arming enabled.");
                TryAutoArmGush();
                continue;
            }
            if (command.Equals(
                "reset", StringComparison.OrdinalIgnoreCase))
            {
                lock (SimulationLock)
                {
                    currentIntensity = 0;
                    targetIntensity = 0;
                    gameActive = false;
                    receivingMovement = false;
                    lastIntensityUpdate = DateTime.MinValue;
                }

                Console.WriteLine("[SIMULATION] Reset to 0%.");
                continue;
            }

            if (TryReadNumber(command, "level", out double level))
            {
                if (level < 0 || level > 100)
                {
                    Console.WriteLine(
                        "Level must be between 0 and 100.");
                    continue;
                }

                lock (SimulationLock)
                    targetIntensity = level;

                Console.WriteLine(
                    "[SIMULATION] Target: " + level + "%");
                continue;
            }

            if (TryReadNumber(command, "speed", out double speed))
            {
                if (speed <= 0 || speed > 1000)
                {
                    Console.WriteLine(
                        "Speed must be greater than 0 and at most 1000.");
                    continue;
                }

                lock (SimulationLock)
                    transitionSpeed = speed;

                Console.WriteLine(
                    "[SIMULATION] Speed: " +
                    speed + "% per second");
                continue;
            }

            if (TryReadNumber(
                command, "timeout", out double timeout))
            {
                if (timeout < 1 || timeout > 3600)
                {
                    Console.WriteLine(
                        "Timeout must be between 1 and 3600 seconds.");
                    continue;
                }

                lock (SimulationLock)
                    inactivityTimeout = timeout;

                Console.WriteLine(
                    "[SIMULATION] Timeout: " +
                    timeout + " seconds");
                continue;
            }

            Console.WriteLine("Unknown command. Type help.");
        }
    }

    static bool TryReadNumber(
        string command,
        string prefix,
        out double value)
    {
        value = 0;

        if (!command.StartsWith(
            prefix + " ",
            StringComparison.OrdinalIgnoreCase))
            return false;

        return double.TryParse(
            command.Substring(prefix.Length + 1).Trim(),
            NumberStyles.Float,
            CultureInfo.InvariantCulture,
            out value) &&
            !double.IsNaN(value) &&
            !double.IsInfinity(value);
    }

    static async Task RunSimulation(CancellationToken token)
    {
        DateTime previous = DateTime.UtcNow;
        int previousDisplayedLevel = -1;
        DateTime previousVirtualConsole = DateTime.MinValue;

        while (!token.IsCancellationRequested)
        {
            await Task.Delay(250, token);

            DateTime now = DateTime.UtcNow;
            double elapsed = (now - previous).TotalSeconds;
            previous = now;

            int displayLevel;
            double target;
            bool timedOut = false;

            lock (SimulationLock)
            {
                if (gameActive &&
                    (now - lastGameHeartbeat).TotalSeconds >=
                    inactivityTimeout)
                {
                    gameActive = false;
                    targetIntensity = 0;
                    timedOut = true;
                    physicalArmed = false;
                    // Connection timeouts are not manual emergency stops.
                    // Auto-arming is allowed again after fresh telemetry returns.
                }

                // Fail safe: never hold the last nonzero game intensity
                // when the game stops sending movement samples.
                if (receivingMovement &&
                    (now - lastIntensityUpdate).TotalSeconds > 2.0)
                {
                    receivingMovement = false;
                    targetIntensity = 0;
                    currentIntensity = 0;
                    timedOut = true;
                    // A short scene transition pauses physical output without disarming.
                    // The physical output loop disarms if telemetry stays absent.
                }

                double maxChange = transitionSpeed * elapsed;

                if (receivingMovement)
                {
                    // The mod has already smoothed this value.
                    // Do not smooth it a second time in the bridge.
                    currentIntensity = targetIntensity;
                }
                else if (currentIntensity < targetIntensity)
                {
                    currentIntensity = Math.Min(
                        currentIntensity + maxChange,
                        targetIntensity);
                }
                else if (currentIntensity > targetIntensity)
                {
                    currentIntensity = Math.Max(
                        currentIntensity - maxChange,
                        targetIntensity);
                }

                currentIntensity =
                    Math.Clamp(currentIntensity, 0, 100);

                displayLevel =
                    (int)Math.Round(currentIntensity);

                target = targetIntensity;
            }

            if (timedOut)
            {
                Console.WriteLine(
                    "[TIMEOUT] Game heartbeat lost.");
                Console.WriteLine(
                    "[SIMULATION] Returning to 0%.");
            }

            if (displayLevel != previousDisplayedLevel &&
                (DateTime.UtcNow - previousVirtualConsole).TotalSeconds >= 2)
            {
                previousVirtualConsole = DateTime.UtcNow;
                previousDisplayedLevel = displayLevel;

                Console.WriteLine(
                    "[VIRTUAL] " + MakeBar(displayLevel) + " " + displayLevel +
                    "% (target " + target.ToString("F1", CultureInfo.InvariantCulture) + "%)");
                PrintMotors();
            }
        }
    }

    // Each channel is independently mapped to an Intiface device/actuator index.
    // Only advertised Vibrate scalar actuators are supported; other actuator types
    // (Rotate, Linear, etc.) require type-specific commands and are not guessed.
    static async Task RunPhysicalOutput(ClientWebSocket socket, CancellationToken token)
    {
        var filtered = new Dictionary<string, double>();
        DateTime lastTick = DateTime.UtcNow;
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(20, token);
                DateTime now = DateTime.UtcNow;
                double dt = Math.Clamp((now-lastTick).TotalSeconds, 0, 0.5);
                lastTick = now;
                List<(int device, int feature, double scalar)> outputs = new();
                bool lostHeartbeat = false;
                lock (SimulationLock)
                {
                    bool heartbeatFresh = gameActive && lastGameHeartbeat != DateTime.MinValue &&
                        (now-lastGameHeartbeat).TotalSeconds < HeartbeatDisconnectSeconds;
                    bool fresh = receivingMovement && heartbeatFresh &&
                        (now-lastIntensityUpdate).TotalSeconds < 1.0;
                    if (!heartbeatFresh && physicalArmed)
                    { physicalArmed = false; lostHeartbeat = true; }
                    bool active = physicalArmed && !emergencyStopped && !autoArmBlocked &&
                        outputLoopHealthy && fresh && movementHandler >= 0;
                    foreach (var m in Motors)
                    {
                        string key = $"{m.DeviceIndex}:{m.FeatureIndex}";
                        double old = filtered.TryGetValue(key, out var prev) ? prev : 0;
                        double desired = 0;
                        if (active && m.Enabled)
                        {
                            bool depthOnly = m.Source == "depth";
                            double sensitivity = movementController == "Live2DBlowjobController" && !depthOnly ? 1.8 : 1.0;
                            desired = Math.Clamp(SelectedMotorPercent(m)*sensitivity*m.Multiplier*(websiteIntensityByDevice.TryGetValue(m.DeviceIndex, out var deviceIntensity) ? deviceIntensity : 1.0), 0, m.MaxPercent)/100;
                            // Events never bypass arming, heartbeat, emergency stop or per-motor enable.
                            if (m.EjacMode != "off")
                            {
                                bool shotMode = m.EjacMode == "shot-override" || m.EjacMode == "shot-additive";
                                double eventEnvelope = shotMode ? ShotEnvelope(now, m.EjacPulse) :
                                    EjaculationEnvelope(now, m.EjacFade, out _);
                                if (eventEnvelope > 0)
                                {
                                    double wave = 1.0;
                                    if (!shotMode)
                                    {
                                        EjaculationEnvelope(now, m.EjacFade, out double elapsed);
                                        double period = Math.Max(0.05, m.EjacPulse);
                                        wave = 0.625 + 0.375 * Math.Sin(2 * Math.PI * elapsed / period);
                                    }
                                    double eventValue = Math.Clamp(m.EjacIntensity * eventEnvelope * wave / 100.0, 0, m.MaxPercent / 100.0);
                                    desired = (m.EjacMode == "override" || m.EjacMode == "shot-override") ? eventValue :
                                        Math.Min(m.MaxPercent / 100.0, desired + eventValue);
                                }
                                else if (m.EjacMode == "shot-override" && IsClimaxActive(now, movementController))
                                {
                                    // During climax, the individual shots take priority.
                                    // Outside climax, preserve normal movement vibration.
                                    desired = 0;
                                }
                            }
                        }
                        // Only bypass the depth-withdrawal gate for shower speed fallback.
                        bool showerSpeedFallback = movementController == "Live2DShowerController";
                        bool withdrawn = !showerSpeedFallback &&
                            (m.Source == "depth" || m.Source == "hybrid" || m.Source == "blend") &&
                            (!normalizedDepthValid || normalizedDepth <= 1.0);
                        bool eventActive = m.EjacMode != "off" &&
                            (m.EjacMode.StartsWith("shot-", StringComparison.Ordinal) ?
                                ShotEnvelope(now, m.EjacPulse) > 0 :
                                EjaculationEnvelope(now, m.EjacFade, out _) > 0);
                        if (!active || !m.Enabled || (withdrawn && !eventActive)) old = 0;
                        else
                        {
                            double rise = m.Source == "depth" ? m.DepthSmoothSeconds : m.SmoothSeconds;
                            double fall = normalizedDepthValid && normalizedDepth < 9 ? 0.02 :
                                movementSpeed < ZeroSpeedThreshold && !m.IdleEnabled ? m.StopFadeSeconds : m.FallSeconds;
                            // Track shower speed changes more closely, without changing other scenes.
                            if (showerSpeedFallback && !eventActive)
                            {
                                rise = Math.Min(rise, 0.055);
                                fall = Math.Min(fall, 0.045);
                            }
                            double tau = eventActive ? 0.04 : desired > old ? rise : fall;
                            double alpha = tau <= 0 ? 1 : 1-Math.Exp(-dt/tau);
                            old += (desired-old)*alpha;
                            if (old < 0.0005 && desired == 0) old = 0;
                        }
                        filtered[key] = old;
                        outputs.Add((m.DeviceIndex, m.FeatureIndex, old));
                    }
                }
                if (lostHeartbeat) Console.WriteLine("[OUTPUT] Game heartbeat lost; outputs zero and disarmed.");
                await SendScalars(socket, outputs, token);
                // Linear commands follow absolute depth, never speed-as-position.
                // Do not issue new movement commands if heartbeat expires, stopped or disarmed.
                List<(int device,int axis,int duration,double position)> linearMoves = new();
                lock (SimulationLock)
                {
                    bool fresh = physicalArmed && !emergencyStopped && !autoArmBlocked &&
                        receivingMovement && gameActive && normalizedDepthValid && movementHandler >= 0 &&
                        (now-lastGameHeartbeat).TotalSeconds < HeartbeatDisconnectSeconds &&
                        (now-lastIntensityUpdate).TotalSeconds < 1.0;
                    if (!fresh) foreach(var a in LinearAxes) a.LastPosition=double.NaN;
                    if (fresh)
                    foreach(var a in LinearAxes)
                    {
                        if (!a.Enabled) continue;
                        double depth=Math.Clamp(normalizedDepth/100,0,1);
                        if (a.Reverse) depth=1-depth;
                        double target=a.Min+(a.Max-a.Min)*depth;
                        // Follow game depth continuously with a tunable low-pass filter.
                        // Repeated small position steps avoid the sharp rectangular plateaus
                        // caused by directly jumping to each 20Hz telemetry sample.
                        double previous=double.IsNaN(a.LastPosition) ? target : a.LastPosition;
                        double alpha=a.WaveSmoothSeconds<=0 ? 1 :
                            1-Math.Exp(-Math.Max(dt,0.001)/a.WaveSmoothSeconds);
                        double position=previous+(target-previous)*alpha;
                        if (Math.Abs(target-position)<0.0005) position=target;
                        if (double.IsNaN(a.LastPosition) || Math.Abs(position-a.LastPosition)>=0.0005)
                        {
                            linearMoves.Add((a.DeviceIndex,a.FeatureIndex,a.DurationMs,position));
                            a.LastPosition=position;
                        }
                    }
                }
                await SendLinears(socket,linearMoves,token);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            lock (SimulationLock) { physicalArmed=false; emergencyStopped=true; autoArmBlocked=true; outputLoopHealthy=false; }
            Console.WriteLine("[OUTPUT ERROR] Disarmed: " + ex.Message);
        }
    }

    static Task SendGushZero(ClientWebSocket socket, CancellationToken token) => SendAllZero(socket, token);
    static Task SendAllZero(ClientWebSocket socket, CancellationToken token)
    {
        List<(int device, int feature, double scalar)> channels;
        lock (SimulationLock)
            channels = Motors.Select(m => (m.DeviceIndex, m.FeatureIndex, 0.0)).ToList();
        return SendScalars(socket, channels, token);
    }

    static async Task SendScalars(ClientWebSocket socket, List<(int device, int feature, double scalar)> channels, CancellationToken token)
    {
        if (socket.State != WebSocketState.Open || channels.Count == 0) return;
        await SendLock.WaitAsync(token);
        try
        {
            foreach (var group in channels.GroupBy(c => c.device))
            {
                var message = new { ScalarCmd = new {
                    Id = Interlocked.Increment(ref commandId), DeviceIndex = group.Key,
                    Scalars = group.Select(c => new { Index=c.feature, Scalar=Math.Clamp(c.scalar,0,1), ActuatorType="Vibrate" }).ToArray()
                }};
                await SendMessage(socket, JsonSerializer.Serialize(new[] { message }), token);
            }
        }
        finally { SendLock.Release(); }
    }

    static async Task SendLinears(ClientWebSocket socket,List<(int device,int axis,int duration,double position)> moves,CancellationToken token)
    {
        if (socket.State!=WebSocketState.Open || moves.Count==0) return;
        await SendLock.WaitAsync(token);
        try
        {
            foreach(var group in moves.GroupBy(m=>m.device))
            {
                var message=new { LinearCmd=new {
                    Id=Interlocked.Increment(ref commandId),DeviceIndex=group.Key,
                    Vectors=group.Select(m=>new {Index=m.axis,Duration=m.duration,Position=Math.Clamp(m.position,0,1)}).ToArray()
                }};
                await SendMessage(socket,JsonSerializer.Serialize(new[]{message}),token);
            }
        }
        finally { SendLock.Release(); }
    }
    static string MakeBar(int level)
    {
        int filled = Math.Clamp(level / 5, 0, 20);

        return "[" +
            new string('#', filled) +
            new string('-', 20 - filled) +
            "]";
    }

    static void TryAutoArmGush()
    {
        bool newlyArmed = false;
        lock (SimulationLock)
        {
            bool heartbeatFresh = gameActive && lastGameHeartbeat != DateTime.MinValue &&
                (DateTime.UtcNow-lastGameHeartbeat).TotalSeconds < HeartbeatDisconnectSeconds;
            if (heartbeatFresh && !physicalArmed && !emergencyStopped && !autoArmBlocked &&
                outputLoopHealthy && (Motors.Exists(m => m.Enabled) || LinearAxes.Exists(a => a.Enabled)))
            { physicalArmed = true; newlyArmed = true; }
        }
        if (newlyArmed) Console.WriteLine("[AUTO-ARMED] Detected vibration channels ready. Type stop to disarm.");
    }

    static void UpdateVirtualVibration(string gameEvent)
    {
        if (!gameEvent.StartsWith("ControllerChanged:",
            StringComparison.Ordinal))
            return;

        bool enteringInteraction = gameEvent.EndsWith(":Live2DInteractionController", StringComparison.Ordinal);
        lock (SimulationLock)
        {
            currentIntensity = 0;
            targetIntensity = 0;
            receivingMovement = false;
            movementHandler = -1;
            movementSpeed = 0;
            onInteractionScreen = enteringInteraction;
        }
        Console.WriteLine("[SIMULATION] Controller changed; physical output paused at zero.");
        LogMovement("[SIMULATION] Controller changed; physical output paused at zero.");
        TryAutoArmGush();
    }

    static bool TryProcessIntensity(string line)
    {
        if (!line.StartsWith("SIM_INTENSITY|", StringComparison.Ordinal))
            return false;

        string controller = "";
        int handler = -1;
        double speed = double.NaN;
        double target = double.NaN;
        double smoothed = double.NaN;
        bool positionValid = false;
        double rawPosition = double.NaN;

        foreach (string field in line.Split('|'))
        {
            int equals = field.IndexOf('=');
            if (equals < 0) continue;
            string key = field.Substring(0, equals);
            string value = field.Substring(equals + 1);
            switch (key)
            {
                case "Controller": controller = value; break;
                case "Handler":
                    int.TryParse(value, NumberStyles.Integer,
                        CultureInfo.InvariantCulture, out handler);
                    break;
                case "Speed":
                    double.TryParse(value, NumberStyles.Float,
                        CultureInfo.InvariantCulture, out speed);
                    break;
                case "Target":
                    double.TryParse(value, NumberStyles.Float,
                        CultureInfo.InvariantCulture, out target);
                    break;
                case "Smoothed":
                    double.TryParse(value, NumberStyles.Float,
                        CultureInfo.InvariantCulture, out smoothed);
                    break;
                case "PositionValid":
                    positionValid = value == "1";
                    break;
                case "RawPosition":
                    double.TryParse(value, NumberStyles.Float,
                        CultureInfo.InvariantCulture, out rawPosition);
                    break;
            }
        }

        if (double.IsNaN(speed) || double.IsInfinity(speed) ||
            double.IsNaN(target) || double.IsInfinity(target) ||
            double.IsNaN(smoothed) || double.IsInfinity(smoothed))
        {
            Console.WriteLine("[SIMULATION] Ignored malformed intensity.");
            return true;
        }

        // Require the source values to agree with the configured cap.
        // Handler -1 means no active movement handler.
        speed = Math.Max(0, speed);
        target = handler < 0 ? 0 : Math.Clamp(speed / 2.0, 0, 1);
        smoothed = handler < 0 ? 0 : Math.Clamp(smoothed, 0, 1);

        bool normalizedValid = TryNormalizeDepth(controller, handler,
            positionValid, rawPosition, out double depthPercent, out string calibrationName);
        string direction = "N/A";
        string observedRange = "N/A";
        lock (SimulationLock)
        {
            if (!DepthByController.TryGetValue(controller, out var stats))
                DepthByController[controller] = stats = new DepthStats();
            RecordDepth(stats, positionValid, rawPosition);
            string handlerKey = controller + " / Handler=" + handler;
            if (!DepthByHandler.TryGetValue(handlerKey, out var handlerStats))
                DepthByHandler[handlerKey] = handlerStats = new DepthStats();
            direction = !positionValid || !double.IsFinite(rawPosition) ? "invalid" :
                !handlerStats.HasPrevious ? "initial" :
                rawPosition > handlerStats.Previous + 0.0001 ? "up" :
                rawPosition < handlerStats.Previous - 0.0001 ? "down" : "steady";
            RecordDepth(handlerStats, positionValid, rawPosition);
            if (positionValid && double.IsFinite(rawPosition))
                observedRange = handlerStats.Minimum.ToString("F4", CultureInfo.InvariantCulture) +
                    ".." + handlerStats.Maximum.ToString("F4", CultureInfo.InvariantCulture);
            normalizedDepthValid = normalizedValid;
            normalizedDepth = normalizedValid ? depthPercent : 0;
            depthCalibration = calibrationName;
            if (controller == "Live2DInteractionController") onInteractionScreen = true;
            movementController = controller;
            movementHandler = handler;
            movementSpeed = speed;
            movementTarget = target * 100.0;
            movementSmoothed = smoothed * 100.0;
            depthPositionValid = positionValid &&
                !double.IsNaN(rawPosition) && !double.IsInfinity(rawPosition);
            depthRawPosition = depthPositionValid ? rawPosition : 0;
            targetIntensity = movementSmoothed;
            currentIntensity = movementSmoothed;
            lastIntensityUpdate = DateTime.UtcNow;
            lastGameHeartbeat = lastIntensityUpdate;
            gameActive = true;
            receivingMovement = true;
        }

        string movementMessage = "[MOVEMENT] " + controller +
            " | Handler=" + handler +
            " | Speed=" + speed.ToString("F4", CultureInfo.InvariantCulture) +
            " | Target=" + (target * 100).ToString("F1", CultureInfo.InvariantCulture) +
            "% | Smoothed=" + (smoothed * 100).ToString("F1", CultureInfo.InvariantCulture) +
            "% | RawDepth=" + (positionValid && !double.IsNaN(rawPosition) && !double.IsInfinity(rawPosition)
                ? rawPosition.ToString("F4", CultureInfo.InvariantCulture)
                : "N/A") +
            " | Depth%=" + (normalizedValid ? depthPercent.ToString("F1", CultureInfo.InvariantCulture) : "N/A") +
            " | Speed%=" + (smoothed * 100).ToString("F1", CultureInfo.InvariantCulture) +
            " | Direction=" + direction +
            " | ObservedRaw=" + observedRange +
            " | Calibration=" + calibrationName +
            " | Depth tracked; optional source mapping may drive Gush";
        LogMovement(movementMessage);
        bool showMovement = controller != lastMovementConsoleController ||
            (DateTime.UtcNow - lastMovementConsole).TotalSeconds >= 2;
        if (showMovement)
        {
            Console.WriteLine(movementMessage);
            lastMovementConsole = DateTime.UtcNow;
            lastMovementConsoleController = controller;
        }
        return true;
    }

    // Event-only diagnostic stage. No changes to physical output or motor mapping.
    private static readonly object EjaculationLock = new();
    private static DateTime? latestShotUtc;
    private static int latestShotIndex;
    private static string latestShotController = "";
    private static DateTime? ejaculationStartedUtc;
    private static string ejaculationController = "";
    private static DateTime? ejaculationEndedUtc;
    private static DateTime? ejaculationLastStartedUtc;

    static bool IsClimaxActive(DateTime now, string controller)
    {
        lock (EjaculationLock)
            return ejaculationStartedUtc.HasValue &&
                ejaculationController == controller &&
                (now - ejaculationStartedUtc.Value).TotalSeconds <= 20;
    }

    static double EjaculationEnvelope(DateTime now, double fadeSeconds, out double elapsed)
    {
        lock (EjaculationLock)
        {
            elapsed = ejaculationLastStartedUtc.HasValue ?
                Math.Max(0, (now - ejaculationLastStartedUtc.Value).TotalSeconds) : 0;
            // Stale start events must not run indefinitely if an END is missed.
            if (ejaculationStartedUtc.HasValue)
                return (now - ejaculationStartedUtc.Value).TotalSeconds <= 20 ? 1 : 0;
            if (ejaculationEndedUtc.HasValue && fadeSeconds > 0)
                return Math.Clamp(1 - (now - ejaculationEndedUtc.Value).TotalSeconds / fadeSeconds, 0, 1);
            return 0;
        }
    }

    // A finite, per-shot triangle: zero at the beginning and end, peak halfway.
    // Uses the existing per-motor pulse duration and intensity settings.
    static double ShotEnvelope(DateTime now, double duration)
    {
        lock (EjaculationLock)
        {
            if (!latestShotUtc.HasValue) return 0;
            double elapsed = (now - latestShotUtc.Value).TotalSeconds;
            double width = Math.Max(0.05, duration);
            if (elapsed < 0 || elapsed >= width) return 0;
            double progress = elapsed / width;
            return progress <= 0.5 ? 2 * progress : 2 * (1 - progress);
        }
    }

    static bool TryProcessShot(string line)
    {
        if (!line.StartsWith("EJAC_SHOT|", StringComparison.Ordinal)) return false;
        string controller = "";
        int shot = 0;
        foreach (string part in line.Split('|'))
        {
            if (part.StartsWith("Controller=", StringComparison.Ordinal)) controller = part.Substring(11);
            else if (part.StartsWith("Shot=", StringComparison.Ordinal))
                int.TryParse(part.Substring(5), NumberStyles.None, CultureInfo.InvariantCulture, out shot);
        }
        if (controller.Length == 0 || controller.Length > 80 || controller.Contains('|') || shot < 1 || shot > 100)
        {
            Console.WriteLine("[SHOT] Ignored malformed event");
            return true;
        }
        lock (EjaculationLock)
        {
            // Prevent stale or duplicated shot indices within the same sequence.
            if (ejaculationStartedUtc.HasValue && ejaculationController == controller &&
                shot > latestShotIndex)
            {
                latestShotUtc = DateTime.UtcNow;
                latestShotIndex = shot;
                latestShotController = controller;
            }
            else
            {
                Console.WriteLine("[SHOT] Ignored out-of-sequence event | Controller=" + controller + " | Shot=" + shot);
                return true;
            }
        }
        string message = "[SHOT] Controller=" + controller + " | Shot=" + shot;
        Console.WriteLine(message);
        LogMovement(message);
        return true;
    }

    static bool TryProcessEjaculation(string line)
    {
        bool start = line.StartsWith("EJAC_START|Controller=", StringComparison.Ordinal);
        bool end = line.StartsWith("EJAC_END|Controller=", StringComparison.Ordinal);
        if (!start && !end) return false;

        string controller = line.Substring((start ? "EJAC_START|Controller=" : "EJAC_END|Controller=").Length).Trim();
        if (controller.Length == 0 || controller.Length > 80 || controller.Contains('|'))
        {
            Console.WriteLine("[EJAC] Ignored malformed event");
            return true;
        }

        string message;
        lock (EjaculationLock)
        {
            DateTime now = DateTime.UtcNow;
            if (start)
            {
                if (ejaculationStartedUtc.HasValue && ejaculationController == controller)
                    message = "[EJAC] Duplicate START ignored | Controller=" + controller;
                else
                {
                    ejaculationStartedUtc = now;
                    latestShotUtc = null;
                    latestShotIndex = 0;
                    latestShotController = "";
                    ejaculationLastStartedUtc = now;
                    ejaculationEndedUtc = null;
                    ejaculationController = controller;
                    message = "[EJAC] START | Controller=" + controller + " | UTC=" + now.ToString("O");
                }
            }
            else if (!ejaculationStartedUtc.HasValue || ejaculationController != controller)
                message = "[EJAC] END without matching START | Controller=" + controller;
            else
            {
                double seconds = (now - ejaculationStartedUtc.Value).TotalSeconds;
                ejaculationStartedUtc = null;
                ejaculationEndedUtc = now;
                ejaculationController = "";
                message = "[EJAC] END | Controller=" + controller + " | Duration=" + seconds.ToString("F3", CultureInfo.InvariantCulture) + "s";
            }
        }
        Console.WriteLine(message);
        LogMovement(message);
        return true;
    }

    static void ProcessGameEvent(string line)
    {
        if (TryProcessIntensity(line))
            return;
        if (TryProcessEjaculation(line))
            return;
        if (TryProcessShot(line))
            return;

        if (line == "GameHeartbeat")
        {
            lock (SimulationLock)
            {
                lastGameHeartbeat = DateTime.UtcNow;
                gameActive = true;
            }

            // Also handles startup when the interaction controller was detected
            // before the first heartbeat or device-list response.
            TryAutoArmGush();
            return;
        }

        Console.WriteLine("[MDRG EVENT] " + line);
        LogMovement("[MDRG EVENT] " + line);
        UpdateVirtualVibration(line);
    }

