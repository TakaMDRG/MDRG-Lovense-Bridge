    static bool ConfigureMotor(string command)
    {
        string[] p = command.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (p.Length == 0 || !p[0].Equals("motor", StringComparison.OrdinalIgnoreCase))
            return false;
        if (p.Length != 4 || !int.TryParse(p[1], out int number) || number < 1 || number > Motors.Count)
        {
            Console.WriteLine("Usage: motor <channel-number> <cap|gain|on|source|blend|cutoff|curve|depthgate|smooth|depthsmooth|fall|stopfade|threshold|idle|idlelevel|ejaculate|ejacintensity|ejacpulse|ejacfade> <value>");
            return true;
        }
        var m = Motors[number - 1];
        lock (SimulationLock)
        {
            if (p[2].Equals("ejaculate", StringComparison.OrdinalIgnoreCase) &&
                (p[3].Equals("off", StringComparison.OrdinalIgnoreCase) ||
                 p[3].Equals("override", StringComparison.OrdinalIgnoreCase) ||
                 p[3].Equals("additive", StringComparison.OrdinalIgnoreCase) ||
                 p[3].Equals("shot-override", StringComparison.OrdinalIgnoreCase) ||
                 p[3].Equals("shot-additive", StringComparison.OrdinalIgnoreCase)))
                m.EjacMode = p[3].ToLowerInvariant();
            else if (p[2].Equals("source", StringComparison.OrdinalIgnoreCase) &&
                (p[3].Equals("speed", StringComparison.OrdinalIgnoreCase) ||
                 p[3].Equals("depth", StringComparison.OrdinalIgnoreCase) ||
                 p[3].Equals("blend", StringComparison.OrdinalIgnoreCase) ||
                 p[3].Equals("hybrid", StringComparison.OrdinalIgnoreCase)))
                m.Source = p[3].ToLowerInvariant();
            else if (p[2].Equals("idle", StringComparison.OrdinalIgnoreCase) &&
                (p[3] == "0" || p[3] == "1" || p[3].Equals("on", StringComparison.OrdinalIgnoreCase) || p[3].Equals("off", StringComparison.OrdinalIgnoreCase)))
                m.IdleEnabled = p[3] == "1" || p[3].Equals("on", StringComparison.OrdinalIgnoreCase);
            else if (p[2].Equals("cutoff", StringComparison.OrdinalIgnoreCase) &&
                (p[3] == "0" || p[3] == "1"))
                m.StopOnZeroSpeed = p[3] == "1";
            else if (p[2].Equals("on", StringComparison.OrdinalIgnoreCase) &&
                (p[3] == "0" || p[3] == "1"))
                m.Enabled = p[3] == "1";
            else if (double.TryParse(p[3], NumberStyles.Float, CultureInfo.InvariantCulture, out double value) &&
                     !double.IsNaN(value) && !double.IsInfinity(value))
            {
                if (p[2].Equals("ejacintensity", StringComparison.OrdinalIgnoreCase) && value >= 0 && value <= 100)
                    m.EjacIntensity = value;
                else if (p[2].Equals("ejacpulse", StringComparison.OrdinalIgnoreCase) && value >= 0.05 && value <= 5)
                    m.EjacPulse = value;
                else if (p[2].Equals("ejacfade", StringComparison.OrdinalIgnoreCase) && value >= 0 && value <= 5)
                    m.EjacFade = value;
                else if (p[2].Equals("idlelevel", StringComparison.OrdinalIgnoreCase) && value >= 0 && value <= 100)
                    m.IdlePercent = value;
                else if (p[2].Equals("cap", StringComparison.OrdinalIgnoreCase) && value >= 0 && value <= 100)
                    m.MaxPercent = value;
                else if (p[2].Equals("gain", StringComparison.OrdinalIgnoreCase) && value >= 0 && value <= 2)
                    m.Multiplier = value;
                else if (p[2].Equals("blend", StringComparison.OrdinalIgnoreCase) && value >= 0 && value <= 1)
                    m.BlendSpeedWeight = value;
                else if (p[2].Equals("curve", StringComparison.OrdinalIgnoreCase) && value >= 0.5 && value <= 4)
                    m.DepthCurve = value;
                else if (p[2].Equals("depthgate", StringComparison.OrdinalIgnoreCase) && value >= 0 && value <= 3)
                    m.HybridDepthGate = value;
                else if (p[2].Equals("smooth", StringComparison.OrdinalIgnoreCase) && value >= 0 && value <= 2)
                    m.SmoothSeconds = value;
                else if (p[2].Equals("depthsmooth", StringComparison.OrdinalIgnoreCase) && value >= 0 && value <= 2)
                    m.DepthSmoothSeconds = value;
                else if (p[2].Equals("fall", StringComparison.OrdinalIgnoreCase) && value >= 0 && value <= 2)
                    m.FallSeconds = value;
                else if (p[2].Equals("stopfade", StringComparison.OrdinalIgnoreCase) && value >= 0 && value <= 2)
                    m.StopFadeSeconds = value;
                else if (p[2].Equals("threshold", StringComparison.OrdinalIgnoreCase) && value >= 0 && value <= 1)
                    ZeroSpeedThreshold = value;
                else
                    Console.WriteLine("Invalid setting: cap 0-100, gain 0-2, blend 0-1, curve 0.5-4, depthgate 0-3, smooth/depthsmooth/fall/stopfade 0-2, threshold 0-1, on/cutoff 0/1.");
            }
            else Console.WriteLine("Invalid value.");
        }
        PrintMotors();
        return true;
    }

    // v3.7.14: The TCP bridge is always available; Intiface connects only on request.
    private static readonly SemaphoreSlim SessionGate = new(1, 1);
    private static ClientWebSocket? activeSocket;
    private static CancellationTokenSource? sessionCancellation;
    private static Task? sessionTask;
    private static string connectionState = "DISCONNECTED";
    private static string connectionError = "";
    private static string IntifaceUrl => Environment.GetEnvironmentVariable("MDRG_INTIFACE_URL")
        ?? "ws://127.0.0.1:12345";

    static string ConnectionReply()
    {
        string state = connectionState;
        string error = connectionError.Replace('\r', ' ').Replace('\n', ' ').Replace('|', '/');
        return "INTIFACE_STATUS|" + state + "|" + error;
    }

    static async Task ConnectIntiface()
    {
        await SessionGate.WaitAsync();
        try
        {
            if (connectionState == "CONNECTED" || connectionState == "CONNECTING") return;
            connectionState = "CONNECTING";
            connectionError = "";
            // Previous session has finished or been explicitly disconnected.
            var socket = new ClientWebSocket();
            var cts = new CancellationTokenSource();
            try
            {
                Console.WriteLine("[INTIFACE] Connecting on game request to " + IntifaceUrl);
                using (var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(7)))
                    await socket.ConnectAsync(new Uri(IntifaceUrl), timeout.Token);
                await SendMessage(socket,
                    "[{\"RequestServerInfo\":{\"Id\":1,\"ClientName\":\"MDRG Bridge\",\"MessageVersion\":3}}]",
                    cts.Token);
                using (var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(5)))
                {
                    string response = await ReceiveMessage(socket, timeout.Token);
                    if (!response.Contains("\"ServerInfo\""))
                        throw new InvalidOperationException("Intiface rejected the handshake.");
                }
                activeSocket = socket;
                sessionCancellation = cts;
                // A successfully negotiated Intiface session starts with a healthy output loop.
                // Keep physical output disarmed until fresh game telemetry and discovered
                // enabled channels satisfy the existing automatic-arming prerequisites.
                // Output-loop exceptions and disconnects still mark this unhealthy.
                lock (SimulationLock) { physicalArmed = false; outputLoopHealthy = true; emergencyStopped = false; autoArmBlocked = false; }
                lock (DeviceLock) { Devices.Clear(); Motors.Clear(); LinearAxes.Clear(); websiteIntensityByDevice.Clear(); }
                connectionState = "CONNECTED";
                Console.WriteLine("[INTIFACE] Connected on player request.");
                await SendMessage(socket, "[{\"RequestDeviceList\":{\"Id\":2}}]", cts.Token);
                sessionTask = RunIntifaceSession(socket, cts);
            }
            catch (Exception ex)
            {
                connectionState = "FAILED";
                connectionError = ex.Message;
                Console.WriteLine("[INTIFACE] Connection failed: " + ex.Message);
                socket.Dispose();
                cts.Dispose();
                activeSocket = null;
                sessionCancellation = null;
            }
        }
        finally { SessionGate.Release(); }
    }

    static async Task RunIntifaceSession(ClientWebSocket socket, CancellationTokenSource cts)
    {
        try
        {
            Task monitor = MonitorIntiface(socket, cts.Token);
            Task output = RunPhysicalOutput(socket, cts.Token);
            await monitor;
            cts.Cancel();
            try { await output; } catch (OperationCanceledException) { }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Console.WriteLine("[INTIFACE] Session error: " + ex.Message); }
        finally
        {
            await SessionGate.WaitAsync();
            try
            {
                if (ReferenceEquals(activeSocket, socket))
                {
                    activeSocket = null;
                    sessionCancellation = null;
                    connectionState = "DISCONNECTED";
                    connectionError = "Intiface connection closed.";
                    lock (SimulationLock) { physicalArmed = false; outputLoopHealthy = false; }
                    lock (DeviceLock) { Devices.Clear(); Motors.Clear(); LinearAxes.Clear(); websiteIntensityByDevice.Clear(); }
                }
            }
            finally { SessionGate.Release(); }
            socket.Dispose();
            cts.Dispose();
        }
    }

    static async Task DisconnectIntiface()
    {
        await SessionGate.WaitAsync();
        try
        {
            if (activeSocket is { State: WebSocketState.Open } socket)
            {
                // Zero output before closing; prevent automatic rearming.
                lock (SimulationLock)
                {
                    physicalArmed = false;
                    emergencyStopped = true;
                    autoArmBlocked = true;
                    currentIntensity = 0;
                    targetIntensity = 0;
                }
                try { await SendAllZero(socket, CancellationToken.None); }
                catch (Exception ex) { Console.WriteLine("[INTIFACE] Zero command failed: " + ex.Message); }
            }
            sessionCancellation?.Cancel();
            activeSocket?.Abort();
            activeSocket = null;
            sessionCancellation = null;
            connectionState = "DISCONNECTED";
            connectionError = "";
            lock (DeviceLock) { Devices.Clear(); Motors.Clear(); LinearAxes.Clear(); websiteIntensityByDevice.Clear(); }
            Console.WriteLine("[INTIFACE] Disconnected on player request.");
        }
        finally { SessionGate.Release(); }
    }

    static async Task Main()
    {
        StartMovementLog();
        using var cancellation = new CancellationTokenSource();
        var listener = new TcpListener(IPAddress.Loopback, 45678);
        Console.WriteLine("MDRG Bridge v3.7.14 - Manual Intiface connection");
        Console.WriteLine("[INTIFACE] Waiting for the in-game Connect button.");
        try
        {
            listener.Start();
            Console.WriteLine("[BRIDGE] Listening on 127.0.0.1:45678");
            PrintHelp();
            Task gameListener = ListenForGame(listener, cancellation.Token);
            Task simulation = RunSimulation(cancellation.Token);
            await ReadCommands(cancellation);
            await DisconnectIntiface();
            cancellation.Cancel();
            listener.Stop();
            try { await Task.WhenAll(gameListener, simulation); }
            catch (OperationCanceledException) { }
            catch (SocketException) when (cancellation.IsCancellationRequested) { }
        }
        catch (Exception ex) { Console.WriteLine("[ERROR] " + ex.Message); }
        finally
        {
            cancellation.Cancel();
            listener.Stop();
            lock (LogLock) { movementLog?.Dispose(); movementLog = null; }
            Console.WriteLine("[BRIDGE] Stopped.");
        }
    }

