                Console.WriteLine($"[LINEAR] {i+1}: {a.Name} device={a.DeviceIndex} axis={a.FeatureIndex} enabled={a.Enabled} range={a.Min:P0}..{a.Max:P0} reverse={a.Reverse} duration={a.DurationMs}ms wavesmooth={a.WaveSmoothSeconds:F2}s");
