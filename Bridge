    private static void PrintDepthRow(string name, DepthStats stats)
    {
        string range = stats.Samples == stats.Invalid ? "N/A" :
            stats.Minimum.ToString("F4", CultureInfo.InvariantCulture) + ".." +
            stats.Maximum.ToString("F4", CultureInfo.InvariantCulture);
        Console.WriteLine(name + " | samples=" + stats.Samples +
            " invalid=" + stats.Invalid + " raw=" + range +
            " at-1=" + stats.NegativeOne + " up=" + stats.Increasing +
            " down=" + stats.Decreasing + " steady=" + stats.Unchanged);
    }

    // Diagnostic calibration only. These are provisional, not validated endpoints.
    // Do not use normalized depth to drive physical actuators yet.
    private static bool TryNormalizeDepth(string controller, int handler,
        bool positionValid, double raw, out double normalized, out string calibration)
    {
        normalized = 0;
        calibration = "unknown";
        if (handler < 0 || !positionValid || !double.IsFinite(raw)) return false;
        if (controller == "Live2DBlowjobController")
        {
            calibration = "blowjob calibrated [0.2000,0.8500]";
            if (raw < 0 || raw > 1) return false;
            normalized = Math.Clamp((raw - 0.2000) / (0.8500 - 0.2000), 0, 1) * 100;
            return true;
        }
        if (controller == "Live2DCowgirlController" ||
            controller == "Live2DDoggyFuckController" ||
            controller == "Live2DMissionaryFuckController")
        {
            calibration = "signed [-1,1] provisional";
            if (raw < -1 || raw > 1) return false;
            normalized = (raw + 1) * 50;
            return true;
        }
        return false;
    }


