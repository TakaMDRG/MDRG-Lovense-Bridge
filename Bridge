    private sealed class DepthStats
    {
        public long Samples;
        public long Invalid;
        public long NegativeOne;
        public long Increasing;
        public long Decreasing;
        public long Unchanged;
        public bool HasPrevious;
        public double Previous;
        public double Minimum = double.PositiveInfinity;
        public double Maximum = double.NegativeInfinity;
    }

    private static void RecordDepth(DepthStats stats, bool valid, double raw)
    {
        stats.Samples++;
        if (!valid || !double.IsFinite(raw))
        {
            stats.Invalid++;
            stats.HasPrevious = false;
            return;
        }
        stats.Minimum = Math.Min(stats.Minimum, raw);
        stats.Maximum = Math.Max(stats.Maximum, raw);
        if (raw == -1) stats.NegativeOne++;
        if (stats.HasPrevious)
        {
            double delta = raw - stats.Previous;
            if (delta > 0.0001) stats.Increasing++;
            else if (delta < -0.0001) stats.Decreasing++;
            else stats.Unchanged++;
        }
        stats.Previous = raw;
        stats.HasPrevious = true;
    }

